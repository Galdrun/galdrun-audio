set(CMAKE_SYSTEM_NAME Linux)
set(MULTIROOM_TOOLS "$ENV{HOME}/.local/share/multiroom-linux")

if(MULTIROOM_TARGET STREQUAL "x86")
    set(CMAKE_SYSTEM_PROCESSOR i686)
    set(CMAKE_CXX_COMPILER i686-linux-gnu-g++)
    set(CMAKE_FIND_ROOT_PATH "${MULTIROOM_TOOLS}/alsa/x86" /usr/i686-linux-gnu)
elseif(MULTIROOM_TARGET MATCHES "^armv[67]$")
    set(CMAKE_SYSTEM_PROCESSOR arm)
    set(triplet armv6-rpi-linux-gnueabihf)
    if(MULTIROOM_TARGET STREQUAL "armv7")
        set(cpu_flags "-march=armv7-a -mtune=cortex-a7 -mfpu=vfpv3-d16 -mfloat-abi=hard")
    else()
        set(cpu_flags "-march=armv6 -mtune=arm1176jzf-s -mfpu=vfp -mfloat-abi=hard")
    endif()
elseif(MULTIROOM_TARGET MATCHES "^armv[89]$")
    set(CMAKE_SYSTEM_PROCESSOR aarch64)
    set(triplet aarch64-rpi3-linux-gnu)
    if(MULTIROOM_TARGET STREQUAL "armv9")
        set(cpu_flags "-march=armv9-a -mtune=generic")
    else()
        set(cpu_flags "-march=armv8-a -mtune=generic")
    endif()
else()
    message(FATAL_ERROR "Unknown MULTIROOM_TARGET: ${MULTIROOM_TARGET}")
endif()

if(triplet)
    set(CMAKE_CXX_COMPILER "${MULTIROOM_TOOLS}/x-tools/${triplet}/bin/${triplet}-g++")
    execute_process(COMMAND "${CMAKE_CXX_COMPILER}" -print-sysroot
        OUTPUT_VARIABLE CMAKE_SYSROOT OUTPUT_STRIP_TRAILING_WHITESPACE
        COMMAND_ERROR_IS_FATAL ANY)
    set(CMAKE_FIND_ROOT_PATH "${MULTIROOM_TOOLS}/alsa/${MULTIROOM_TARGET}" "${CMAKE_SYSROOT}")
    set(CMAKE_CXX_FLAGS_INIT "${cpu_flags} -isystem ${MULTIROOM_TOOLS}/include")
    set(CMAKE_EXE_LINKER_FLAGS_INIT "-static-libstdc++ -static-libgcc")
    # ARMv6 cannot implement 64-bit atomic operations inline.
    set(CMAKE_CXX_STANDARD_LIBRARIES_INIT "-latomic")
endif()

set(ALSA_INCLUDE_DIR "${MULTIROOM_TOOLS}/alsa/${MULTIROOM_TARGET}/include" CACHE PATH "")
set(ALSA_LIBRARY "${MULTIROOM_TOOLS}/alsa/${MULTIROOM_TARGET}/lib/libasound.so" CACHE FILEPATH "")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_SKIP_BUILD_RPATH TRUE)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES MULTIROOM_TARGET)
