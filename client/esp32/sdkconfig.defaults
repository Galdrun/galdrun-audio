# Common to every board; boards/<board>.defaults adds the chip, its PSRAM and
# the wiring on top (CMakeLists.txt). 4 MB flash is the smallest module any
# board ships with.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The ring buffer (prebufferMs, 1500 ms by default) lives in PSRAM: anything
# above the malloc threshold goes there, thread stacks and DMA stay internal.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
CONFIG_FREERTOS_HZ=1000

# More sockets than the default 10: control server and its clients, the two
# server connections, the discovery beacon, the settings page (3 + its own 3)
# and the captive DNS.
CONFIG_LWIP_MAX_SOCKETS=20

# Phones send long headers with their captive-portal checks.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Network receive path. The lwIP default window (5760 bytes, 4 segments) caps
# a TCP stream at window / round trip: 384 KB/s at 15 ms, exactly what 48 kHz
# 24-in-32 needs, so the ring buffer ran dry. 64 KB leaves about 11x headroom.
# The extra Wi-Fi and lwIP buffers go to PSRAM; internal RAM is tight.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_RX_BA_WIN=32

# Cores: Wi-Fi (pinned by IDF) and lwIP on core 0, so a received packet goes
# from the driver to the stack without crossing cores; the audio side
# (client_i2s, client_main and with it the I2S interrupt) on core 1.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# The ESP-IDF default is 160 MHz. Wi-Fi, lwIP and decoding share the CPU;
# 240 MHz leaves the audio threads more room. I2S still clocks from the 160 MHz
# PLL, independent of the CPU clock.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# The `diagnostics` command's task report: every task's core, priority and
# share of a core (app/TaskReport.h). A 64-bit counter, so the microseconds do
# not wrap after 71 minutes.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
