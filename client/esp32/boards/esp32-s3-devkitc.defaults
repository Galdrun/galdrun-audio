# ESP32-S3-DevKitC-1 with an N8R8 or N16R8 module (octal PSRAM) and an ES8388
# board or a plain I2S DAC on free pins. The ESP32 numbers do not carry over:
# 22-25 do not exist, 26-32 are flash and PSRAM, 33-37 octal PSRAM. A module
# with quad PSRAM (N8R2, N4R2) needs CONFIG_SPIRAM_MODE_QUAD=y instead, or it
# stops at boot.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# BOOT.
CONFIG_MULTIROOM_SETUP_BUTTON_GPIO=0

CONFIG_MULTIROOM_CODEC_I2C_SDA=8
CONFIG_MULTIROOM_CODEC_I2C_SCL=9
CONFIG_MULTIROOM_CODEC_PA_GPIO=10
CONFIG_MULTIROOM_CODEC_I2S_MCLK=4
CONFIG_MULTIROOM_CODEC_I2S_BCLK=5
CONFIG_MULTIROOM_CODEC_I2S_WS=6
CONFIG_MULTIROOM_CODEC_I2S_DOUT=7

CONFIG_MULTIROOM_EXT_I2S_MCLK=-1
CONFIG_MULTIROOM_EXT_I2S_BCLK=15
CONFIG_MULTIROOM_EXT_I2S_WS=16
CONFIG_MULTIROOM_EXT_I2S_DOUT=17
