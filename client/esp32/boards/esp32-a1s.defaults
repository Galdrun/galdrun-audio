# AI-Thinker ESP32 Audio Kit v2.2: ESP32-A1S (ESP32-D0WD, 4 MB flash,
# 8 MB PSRAM of which 4 MB are addressable), ES8388 codec, KEY1-KEY6.
CONFIG_IDF_TARGET="esp32"

CONFIG_MULTIROOM_SETUP_BUTTON_GPIO=36

CONFIG_MULTIROOM_CODEC_I2C_SDA=33
CONFIG_MULTIROOM_CODEC_I2C_SCL=32
CONFIG_MULTIROOM_CODEC_PA_GPIO=21
CONFIG_MULTIROOM_CODEC_I2S_MCLK=0
CONFIG_MULTIROOM_CODEC_I2S_BCLK=27
CONFIG_MULTIROOM_CODEC_I2S_WS=25
CONFIG_MULTIROOM_CODEC_I2S_DOUT=26

# An external DAC shares these with KEY6, KEY5 and KEY4 (esp32-a1s.inputs.json):
# with one wired, take those keys out of client.json.
CONFIG_MULTIROOM_EXT_I2S_MCLK=-1
CONFIG_MULTIROOM_EXT_I2S_BCLK=5
CONFIG_MULTIROOM_EXT_I2S_WS=18
CONFIG_MULTIROOM_EXT_I2S_DOUT=23
