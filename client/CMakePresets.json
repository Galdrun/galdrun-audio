{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x64",
      "inherits": "linux-base"
    },
    {
      "name": "linux-x86",
      "displayName": "Linux x86",
      "inherits": "linux-base",
      "toolchainFile": "${sourceDir}/cmake/LinuxCross.cmake",
      "cacheVariables": {
        "MULTIROOM_TARGET": "x86",
        "MULTIROOM_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "linux-armv6",
      "displayName": "Linux armv6 (Pi 1/Zero)",
      "inherits": "linux-base",
      "toolchainFile": "${sourceDir}/cmake/LinuxCross.cmake",
      "cacheVariables": {
        "MULTIROOM_TARGET": "armv6",
        "MULTIROOM_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "linux-armv7",
      "displayName": "Linux armv7 (Pi 2, 32-bit)",
      "inherits": "linux-base",
      "toolchainFile": "${sourceDir}/cmake/LinuxCross.cmake",
      "cacheVariables": {
        "MULTIROOM_TARGET": "armv7",
        "MULTIROOM_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "linux-armv8",
      "displayName": "Linux armv8 (Pi 3/4/5, 64-bit)",
      "inherits": "linux-base",
      "toolchainFile": "${sourceDir}/cmake/LinuxCross.cmake",
      "cacheVariables": {
        "MULTIROOM_TARGET": "armv8",
        "MULTIROOM_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "linux-armv9",
      "displayName": "Linux armv9 (ARMv9 hardware only)",
      "inherits": "linux-base",
      "toolchainFile": "${sourceDir}/cmake/LinuxCross.cmake",
      "cacheVariables": {
        "MULTIROOM_TARGET": "armv9",
        "MULTIROOM_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "linux-x64",
      "configurePreset": "linux-x64"
    },
    {
      "name": "linux-x86",
      "configurePreset": "linux-x86"
    },
    {
      "name": "linux-armv6",
      "configurePreset": "linux-armv6"
    },
    {
      "name": "linux-armv7",
      "configurePreset": "linux-armv7"
    },
    {
      "name": "linux-armv8",
      "configurePreset": "linux-armv8"
    },
    {
      "name": "linux-armv9",
      "configurePreset": "linux-armv9"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-x64",
      "configurePreset": "linux-x64",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
