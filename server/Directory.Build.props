<Project>
  <Import Project="$(MSBuildThisFileDirectory)../shared/branding/Branding.props" />
  <!-- Roadmap rule 1: net11.0, C# latest, warnings as errors, analyzers on.
       When .NET 11 reaches RTM this file does not change; only the SDK does. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <IsPackable>false</IsPackable>
    <!-- One version for the server and the core (server-core/CMakeLists.txt reads it too). -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../shared/branding/server-version.txt').Trim())</Version>
  </PropertyGroup>
</Project>
