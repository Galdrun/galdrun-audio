<Project Sdk="Microsoft.NET.Sdk">

  <!-- Hosting and logging abstractions come from the shared framework, as for
       the host: no NuGet package. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- The library's three packages. Microsoft.Data.Sqlite follows the SDK's release, as the
       framework does. SMBLibrary reads smb folders (phase 13). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0-rc.1.26425.128" />
    <PackageReference Include="SMBLibrary" Version="1.5.8.1" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Multiroom.Server.Abstractions\Multiroom.Server.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\*.sql" LogicalName="migrations/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
