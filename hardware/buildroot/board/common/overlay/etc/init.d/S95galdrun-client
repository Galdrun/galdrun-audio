#!/bin/sh
set -eu
umask 077
binary=/opt/galdrun-client/galdrun-client
pidfile=/run/galdrun-client.pid
export LD_LIBRARY_PATH=/opt/galdrun-client/lib
export XDG_CONFIG_HOME=/etc

start() {
    if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then return 0; fi
    mkdir -p /etc/galdrun
    if [ ! -f /etc/galdrun/client.json ]; then
        cp /opt/galdrun-client/client-default.json /etc/galdrun/client.json
    fi
    set --
    if grep -q ' /run/log tmpfs ' /proc/mounts; then
        set -- --log-file /run/log/galdrun-client.log
    fi
    start-stop-daemon -S -b -m -p "$pidfile" -x "$binary" -- \
        --config /etc/galdrun/client.json --audio-cache /etc/galdrun/audio_devices.json \
        "$@"
}

stop() {
    [ -f "$pidfile" ] || return 0
    pid=$(cat "$pidfile")
    if ! kill -0 "$pid" 2>/dev/null; then rm -f "$pidfile"; return 0; fi
    start-stop-daemon -K -p "$pidfile" -x "$binary" || return 1
    for attempt in $(seq 1 100); do
        if ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$pidfile"
            return 0
        fi
        sleep 0.1
    done
    echo 'Audio client did not stop; leaving its PID file for inspection' >&2
    return 1
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop && start ;;
    status)
        [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null
        ;;
    *) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 1 ;;
esac
