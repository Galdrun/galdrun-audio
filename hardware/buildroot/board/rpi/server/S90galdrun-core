#!/bin/sh
# The Galdrun core on the Pi server image (scripts/build-server-image.sh). It starts
# before the server (S91) and the client (S95), and rcK stops it after both.
set -eu
umask 077
binary=/opt/galdrun-core/galdrun-core
pidfile=/run/galdrun-core.pid
export LD_LIBRARY_PATH=/opt/galdrun-core/lib

start() {
    if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then return 0; fi
    mkdir -p /etc/galdrun
    if [ ! -f /etc/galdrun/core.json ]; then
        cp /opt/galdrun-core/core-default.json /etc/galdrun/core.json
    fi
    set --
    if grep -q ' /run/log tmpfs ' /proc/mounts; then
        set -- --log-file /run/log/galdrun-core.log
    fi
    start-stop-daemon -S -b -m -p "$pidfile" -x "$binary" -- --config /etc/galdrun/core.json "$@"
}

stop() {
    [ -f "$pidfile" ] || return 0
    pid=$(cat "$pidfile")
    if ! kill -0 "$pid" 2>/dev/null; then rm -f "$pidfile"; return 0; fi
    start-stop-daemon -K -p "$pidfile" -x "$binary" || return 1
    for attempt in $(seq 1 100); do
        if ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$pidfile"
            return 0
        fi
        sleep 0.1
    done
    echo 'Core did not stop; leaving its PID file for inspection' >&2
    return 1
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart) stop && start ;;
    status)
        [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null
        ;;
    *) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 1 ;;
esac
