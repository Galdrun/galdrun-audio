# Use the stock board's CPU supply and normal 792/996 MHz operating points.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPUFREQ_DT=y
CONFIG_ARM_IMX_CPUFREQ_DT=y
CONFIG_MFD_AXP20X_I2C=y
CONFIG_REGULATOR_AXP20X=y
# CONFIG_CPU_IDLE is not set
CONFIG_SUSPEND=y
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
# CONFIG_MODULES is not set
# CONFIG_MTD is not set
# CONFIG_MMC is not set
# CONFIG_ATA is not set
# CONFIG_SCSI is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_BT is not set
CONFIG_SOC_IMX7D=y
CONFIG_FEC=y
CONFIG_SMSC_PHY=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
# Keep PCIe link power transitions out of the initial Wi-Fi bring-up.
CONFIG_PCIEASPM_PERFORMANCE=y
CONFIG_PCI_IMX6_HOST=y
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MWIFIEX=y
CONFIG_MWIFIEX_PCIE=y
CONFIG_RFKILL=y
CONFIG_FW_LOADER=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_FSL_SAI=y
CONFIG_SND_SOC_IMX_PCM_DMA=y
CONFIG_SND_SOC_GALDRUN_CONNECTOR3=y
CONFIG_SND_SOC_SPDIF=y
CONFIG_SERIAL_IMX=y
CONFIG_SERIAL_IMX_CONSOLE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_IMX_RNGC=y
# System suspend is available for qualification, but deep sleep additionally
# needs a platform firmware suspend implementation. Do not advertise it yet.
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_CMDLINE="console=ttymxc0,115200n8 earlycon=ec_imx6q,0x30860000,115200 rdinit=/init clk_ignore_unused maxcpus=1 panic=10 mwifiex.debug_mask=0x7"
CONFIG_CMDLINE_FORCE=y
