# Preserve the running vendor OS's CPU/PMIC state during the first RAM test.
# CONFIG_CPU_FREQ is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_SUSPEND is not set
# CONFIG_MODULES is not set
# CONFIG_MTD is not set
# CONFIG_MMC is not set
# CONFIG_ATA is not set
# CONFIG_SCSI is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_BT is not set
CONFIG_SOC_IMX7D=y
CONFIG_FEC=y
CONFIG_SMSC_PHY=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
# Keep PCIe link power transitions out of the initial Wi-Fi bring-up.
CONFIG_PCIEASPM_PERFORMANCE=y
CONFIG_PCI_IMX6_HOST=y
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MWIFIEX=y
CONFIG_MWIFIEX_PCIE=y
CONFIG_RFKILL=y
CONFIG_FW_LOADER=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_FSL_SAI=y
CONFIG_SND_SOC_IMX_PCM_DMA=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_SOC_SPDIF=y
CONFIG_SERIAL_IMX=y
CONFIG_SERIAL_IMX_CONSOLE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_IMX_RNGC=y
# Kexec needs PM_SLEEP_SMP on ARM SMP. Keep PM disabled for this bring-up;
# the installed vendor kernel loads each test image instead.
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_CMDLINE="console=ttymxc0,115200n8 rdinit=/init clk_ignore_unused maxcpus=1 panic=10 mwifiex.debug_mask=0x40000057"
CONFIG_CMDLINE_FORCE=y
