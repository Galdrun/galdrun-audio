// SPDX-License-Identifier: GPL-2.0-only
/dts-v1/;
#include "imx7d.dtsi"

/* Match the working vendor GPIO levels and sequence radio power/reset. The debugfs
 * pad-level readback reports low even for some driven-high outputs.
 * Wiring: Teufel's published S810 DTS and this unit's live, fixed-up DTB. */
/ {
    model = "Galdrun Connector 3 RAM test";
    compatible = "fsl,imx7d-teufel-streamer", "fsl,imx7d";
    aliases { ethernet0 = &fec2; };
    chosen { stdout-path = "serial0:115200n8"; };
    memory@80000000 {
        device_type = "memory";
        reg = <0x80000000 0x1fc00000>;
    };

    /* Keep the failed boot's console in RAM across a warm reboot. This lies
     * inside the vendor's CMA pool, away from its early kernel allocations.
     * Recovery is best effort: vendor firmware may reuse it after reboot. */
    reserved-memory {
        #address-cells = <1>;
        #size-cells = <1>;
        ranges;
        ramoops@9d000000 {
            compatible = "ramoops";
            reg = <0x9d000000 0x100000>;
            record-size = <0x20000>;
            console-size = <0x80000>;
            mem-type = <1>;
        };
    };

    wifi_supply: regulator-wifi {
        compatible = "regulator-fixed";
        regulator-name = "wifi-power-enable";
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        /* The vendor driver first drives GPIO5_2 low, then enables power
         * before releasing PERST#. Holding it high across kexec leaves the
         * radio's firmware/reset state dependent on the preceding kernel. */
        gpio = <&gpio5 2 GPIO_ACTIVE_HIGH>;
        enable-active-high;
        startup-delay-us = <100000>;
        off-on-delay-us = <100000>;
    };

    audio_out: audio-output {
        compatible = "linux,spdif-dit";
        #sound-dai-cells = <0>;
    };

    sound {
        compatible = "galdrun,connector3-audio";
        audio-cpu = <&sai1>;
        audio-codec = <&audio_out>;
        /* Mainline leaves AUDIO_MCLK_ROOT_CLK unregistered; use its actual
         * divider. Retune the main PLL, not its rate-gated post-divider. */
        clocks = <&clks IMX7D_PLL_AUDIO_MAIN>,
                 <&clks IMX7D_AUDIO_MCLK_ROOT_DIV>,
                 <&clks IMX7D_SAI1_ROOT_CLK>;
        clock-names = "pll", "mclk", "sai";
        assigned-clocks = <&clks IMX7D_AUDIO_MCLK_ROOT_SRC>,
                          <&clks IMX7D_AUDIO_MCLK_ROOT_DIV>;
        assigned-clock-parents = <&clks IMX7D_PLL_AUDIO_POST_DIV>;
        assigned-clock-rates = <0>, <24576000>;
    };
};

&cpu1 { status = "disabled"; };

/* Reserved for the CPU-off suspend trampoline and its translation table.
 * The mmio-sram driver excludes reserved children from its allocation pool. */
&ocram {
    suspend-reserved@0 { reg = <0 0x4000>; };
};

&cpu0 { cpu-supply = <&vdd_arm>; };

/* The stock firmware uses 792 and 996 MHz. Do not expose its optional
 * 1.2 GHz overdrive point, even if this chip's speed fuse allows it. */
&cpu0_opp_table { /delete-node/ opp-1200000000; };

&i2c4 {
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_i2c4>;
    clock-frequency = <100000>;
    status = "okay";
    pmic: pmic@32 {
        compatible = "x-powers,axp152";
        reg = <0x32>;
        interrupt-parent = <&gpc>;
        interrupts = <GIC_SPI 56 IRQ_TYPE_LEVEL_HIGH>;
        regulators {
            vdd_arm: dcdc4 {
                regulator-name = "vdd_arm";
                regulator-min-microvolt = <950000>;
                regulator-max-microvolt = <1100000>;
                regulator-boot-on;
                regulator-always-on;
            };
        };
    };
};

/* The vendor DT disables this block. Probing it from the RAM
 * kernel faults at 0x30900004 before userspace can start. */
&crypto { status = "disabled"; };

&gpio1 {
    carrier-idle {
        gpio-hog;
        gpios = <8 GPIO_ACTIVE_HIGH>;
        output-high;
        line-name = "carrier-vendor-idle";
    };
};

&gpio4 {
    wifi-disable-idle {
        gpio-hog;
        gpios = <20 GPIO_ACTIVE_HIGH>;
        output-high;
        line-name = "wifi-disable-vendor-idle";
    };
};

&gpio5 {
    ethernet-assert {
        gpio-hog;
        gpios = <11 GPIO_ACTIVE_HIGH>;
        output-low;
        line-name = "ethernet-vendor-assert";
    };
};

&pcie {
    /* Let the DesignWare host map inbound Wi-Fi DMA into system RAM. */
    dma-ranges = <0x02000000 0 0x80000000 0x80000000 0 0x20000000>;
    vpcie-supply = <&wifi_supply>;
    /* GPIO4 DR bit 23 is high with vendor Wi-Fi working: reset is active low. */
    reset-gpios = <&gpio4 23 GPIO_ACTIVE_LOW>;
    status = "okay";
};

&uart1 {
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_uart1>;
    assigned-clocks = <&clks IMX7D_UART1_ROOT_SRC>;
    assigned-clock-parents = <&clks IMX7D_OSC_24M_CLK>;
    status = "okay";
};

/* The front-panel MCU uses serial2 in the vendor DT. */
&uart3 {
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_uart3>;
    assigned-clocks = <&clks IMX7D_UART3_ROOT_SRC>;
    assigned-clock-parents = <&clks IMX7D_OSC_24M_CLK>;
    status = "okay";
};

&fec2 {
    fsl,magic-packet;
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_enet2>;
    clocks = <&clks IMX7D_ENET2_IPG_ROOT_CLK>,
             <&clks IMX7D_ENET_AXI_ROOT_CLK>,
             <&clks IMX7D_ENET2_TIME_ROOT_CLK>,
             <&clks IMX7D_PLL_ENET_MAIN_125M_CLK>,
             <&clks IMX7D_ENET2_REF_ROOT_DIV>;
    assigned-clocks = <&clks IMX7D_ENET2_TIME_ROOT_SRC>,
                      <&clks IMX7D_ENET2_TIME_ROOT_CLK>,
                      <&clks IMX7D_ENET2_REF_ROOT_SRC>,
                      <&clks IMX7D_ENET2_REF_ROOT_DIV>;
    assigned-clock-parents = <&clks IMX7D_PLL_ENET_MAIN_100M_CLK>, <0>,
                            <&clks IMX7D_PLL_ENET_MAIN_50M_CLK>, <0>;
    assigned-clock-rates = <0>, <100000000>, <0>, <50000000>;
    phy-mode = "rmii";
    phy-handle = <&ethphy>;
    status = "okay";
    mdio {
        #address-cells = <1>;
        #size-cells = <0>;
        /* GPIO4 DR bit 22 is high while vendor Ethernet is up. */
        reset-gpios = <&gpio4 22 GPIO_ACTIVE_LOW>;
        reset-delay-us = <10000>;
        reset-post-delay-us = <30000>;
        ethphy: ethernet-phy@0 { reg = <0>; };
    };
};

&sai1 {
    #sound-dai-cells = <0>;
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_sai1 &pinctrl_sai1_mclk>;
    assigned-clocks = <&clks IMX7D_PLL_AUDIO_POST_DIV>,
                      <&clks IMX7D_SAI1_ROOT_SRC>,
                      <&clks IMX7D_SAI1_ROOT_CLK>;
    assigned-clock-parents = <0>, <&clks IMX7D_PLL_AUDIO_POST_DIV>;
    assigned-clock-rates = <884736000>, <0>, <24576000>;
    fsl,sai-mclk-direction-output;
    status = "okay";
};

&iomuxc {
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_preserved_gpio &pinctrl_32khz>;
    pinctrl_i2c4: i2c4grp {
        fsl,pins = <
            MX7D_PAD_ENET1_RGMII_TD2__I2C4_SCL 0x4000007f
            MX7D_PAD_ENET1_RGMII_TD3__I2C4_SDA 0x4000007f
        >;
    };
    pinctrl_preserved_gpio: preserved-gpiogrp {
        fsl,pins = <
            MX7D_PAD_GPIO1_IO08__GPIO1_IO8 0x14
            MX7D_PAD_ECSPI2_SCLK__GPIO4_IO20 0x14
            MX7D_PAD_ECSPI2_MISO__GPIO4_IO22 0x80000000
            MX7D_PAD_ECSPI2_SS0__GPIO4_IO23 0x14
            MX7D_PAD_SD1_RESET_B__GPIO5_IO2 0x14
            MX7D_PAD_SD2_RESET_B__GPIO5_IO11 0x80000000
        >;
    };
    pinctrl_32khz: clko2grp {
        fsl,pins = <MX7D_PAD_SD1_WP__CCM_CLKO2 0x14>;
    };
    pinctrl_uart1: uart1grp {
        fsl,pins = <
            MX7D_PAD_UART1_TX_DATA__UART1_DCE_TX 0x79
            MX7D_PAD_UART1_RX_DATA__UART1_DCE_RX 0x79
        >;
    };
    pinctrl_uart3: uart3grp {
        fsl,pins = <
            MX7D_PAD_UART3_RX_DATA__UART3_DCE_RX 0x60
            MX7D_PAD_UART3_TX_DATA__UART3_DCE_TX 0x60
        >;
    };
    pinctrl_enet2: enet2grp {
        fsl,pins = <
            MX7D_PAD_GPIO1_IO14__ENET2_MDIO 0x03
            MX7D_PAD_GPIO1_IO15__ENET2_MDC 0x03
            MX7D_PAD_EPDC_GDRL__ENET2_RGMII_TX_CTL 0x01
            MX7D_PAD_EPDC_SDCE2__ENET2_RGMII_TD0 0x01
            MX7D_PAD_EPDC_SDCE3__ENET2_RGMII_TD1 0x01
            MX7D_PAD_EPDC_SDCE0__ENET2_RGMII_RX_CTL 0x01
            MX7D_PAD_EPDC_SDCLK__ENET2_RGMII_RD0 0x01
            MX7D_PAD_EPDC_SDLE__ENET2_RGMII_RD1 0x01
            MX7D_PAD_EPDC_SDCE1__ENET2_RX_ER 0x01
            MX7D_PAD_EPDC_BDR0__CCM_ENET_REF_CLK2 0x40000001
        >;
    };
    pinctrl_sai1: sai1grp {
        fsl,pins = <
            MX7D_PAD_ENET1_RX_CLK__SAI1_TX_BCLK 0x1f
            MX7D_PAD_SAI1_TX_SYNC__SAI1_TX_SYNC 0x1f
            MX7D_PAD_ENET1_COL__SAI1_TX_DATA0 0x1f
            MX7D_PAD_SAI1_RX_DATA__SAI1_RX_DATA0 0x1f
            MX7D_PAD_ENET1_RGMII_TX_CTL__SAI1_RX_SYNC 0x1f
            MX7D_PAD_ENET1_RGMII_TXC__SAI1_RX_BCLK 0x1f
            MX7D_PAD_SAI1_RX_SYNC__SAI1_RX_SYNC 0x1f
        >;
    };
};

&iomuxc_lpsr {
    pinctrl_sai1_mclk: sai1-mclkgrp {
        fsl,pins = <MX7D_PAD_LPSR_GPIO1_IO01__SAI1_MCLK 0x14>;
    };
};
