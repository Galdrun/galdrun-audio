From: Galdrun Audio
Subject: [PATCH] regulator: expose AXP152 DCDC4 CPU supply on Connector 3

The stock S810 DT wires vdd_arm to DCDC4. Register only that rail,
using the standard regmap voltage operations. Preserve all output enables,
other rails and the bootloader switching frequency.

--- a/drivers/mfd/axp20x.c
+++ b/drivers/mfd/axp20x.c
@@ -1026,6 +1026,7 @@
 };
 
 static const struct mfd_cell axp152_cells[] = {
+	{ .name = "axp20x-regulator" },
 	{
 		.name		= "axp20x-pek",
 		.num_resources	= ARRAY_SIZE(axp152_pek_resources),
--- a/drivers/regulator/axp20x-regulator.c
+++ b/drivers/regulator/axp20x-regulator.c
@@ -594,6 +594,30 @@
 	.disable		= regulator_disable_regmap,
 	.is_enabled		= regulator_is_enabled_regmap,
 	.set_ramp_delay		= axp20x_set_ramp_delay,
+};
+
+/* Connector 3 uses AXP152 DCDC4 for the CPU. Keep every other rail and
+ * the bootloader's switching frequency untouched. The CPU rail stays on. */
+static const struct regulator_ops axp152_cpu_ops = {
+	.set_voltage_sel = regulator_set_voltage_sel_regmap,
+	.get_voltage_sel = regulator_get_voltage_sel_regmap,
+	.list_voltage = regulator_list_voltage_linear,
+};
+
+static const struct regulator_desc axp152_cpu_regulators[] = {
+	{
+		.name = "dcdc4",
+		.of_match = "dcdc4",
+		.regulators_node = "regulators",
+		.type = REGULATOR_VOLTAGE,
+		.owner = THIS_MODULE,
+		.min_uV = 700000,
+		.uV_step = 25000,
+		.n_voltages = 64,
+		.vsel_reg = AXP152_DCDC4_V_OUT,
+		.vsel_mask = GENMASK(5, 0),
+		.ops = &axp152_cpu_ops,
+	},
 };
 
 static const struct regulator_ops axp20x_ops_sw = {
@@ -1564,6 +1588,10 @@
 	bool drivevbus = false;
 
 	switch (axp20x->variant) {
+	case AXP152_ID:
+		regulators = axp152_cpu_regulators;
+		nregulators = ARRAY_SIZE(axp152_cpu_regulators);
+		break;
 	case AXP202_ID:
 	case AXP209_ID:
 		regulators = axp20x_regulators;
@@ -1615,7 +1643,8 @@
 	}
 
 	/* This only sets the dcdc freq. Ignore any errors */
-	axp20x_regulator_parse_dt(pdev);
+	if (axp20x->variant != AXP152_ID)
+		axp20x_regulator_parse_dt(pdev);
 
 	for (i = 0; i < nregulators; i++) {
 		const struct regulator_desc *desc = &regulators[i];
