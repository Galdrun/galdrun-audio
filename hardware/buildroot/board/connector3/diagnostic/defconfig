# Experimental USB RAM boot only. No installer and no storage drivers.
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_FPU_NEON_VFPV4=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_ARMV7_EABIHF_GLIBC_STABLE=y
BR2_INIT_NONE=y
BR2_TARGET_GENERIC_HOSTNAME="connector3-diag"
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_RAUMFELD_PATH)/board/common/patches $(BR2_EXTERNAL_RAUMFELD_PATH)/board/connector3/diagnostic/patches"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_RAUMFELD_PATH)/board/connector3/diagnostic/post-build.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.112"
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="imx_v6_v7"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RAUMFELD_PATH)/board/connector3/diagnostic/linux.fragment"
BR2_LINUX_KERNEL_ZIMAGE=y
BR2_LINUX_KERNEL_XZ=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_DIR="$(BR2_EXTERNAL_RAUMFELD_PATH)/board/connector3/diagnostic/dts"
BR2_LINUX_KERNEL_INTREE_DTS_NAME="nxp/imx/imx7d-galdrun-connector3-diag"
BR2_PACKAGE_OPENSSH=y
# BR2_PACKAGE_OPENSSH_CLIENT is not set
BR2_PACKAGE_OPENSSH_SERVER=y
BR2_PACKAGE_OPENSSH_KEY_UTILS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_FIT_SUPPORT=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_FIT_SIGNATURE_SUPPORT=y
BR2_TARGET_OPTEE_OS=y
BR2_TARGET_OPTEE_OS_CUSTOM_VERSION=y
BR2_TARGET_OPTEE_OS_CUSTOM_VERSION_VALUE="3.15.0"
BR2_TARGET_OPTEE_OS_PLATFORM="imx"
BR2_TARGET_OPTEE_OS_PLATFORM_FLAVOR="mx7dsabresd"
# Factory U-Boot calls OP-TEE during armv7_init_nonsec(), then resumes to pass
# Linux its relocated/fixed-up DTB. An empty NS entry selects the caller's LR.
# There is no DTB argument at this monitor entry point; do not use the FIT's
# original DTB address, which may no longer be the one U-Boot passes to Linux.
BR2_TARGET_OPTEE_OS_ADDITIONAL_VARIABLES="LDFLAGS=-znoexecstack CFG_WERROR=n CFG_DDR_SIZE=0x20000000 CFG_TZDRAM_START=0x9fd00000 CFG_TZDRAM_SIZE=0x300000 CFG_SHMEM_START=0x9fc00000 CFG_SHMEM_SIZE=0x100000 CFG_NSEC_DDR_0_SIZE=0x1fc00000 CFG_DT_ADDR=0 CFG_NS_ENTRY_ADDR= CFG_TEE_CORE_LOG_LEVEL=1 CFG_CORE_ASLR=n CFG_WITH_PAGER=n CFG_RPMB_FS=n CFG_REE_FS=n"
BR2_TARGET_OPTEE_OS_CORE_IMAGES="tee.elf"
# BR2_TARGET_OPTEE_OS_SDK is not set
# BR2_TARGET_OPTEE_OS_SERVICES is not set
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_INITRAMFS=y
# BR2_TARGET_ROOTFS_TAR is not set
