 	SOC_DOUBLE("Master Capture Switch", CS4271_ADCCTL, 3, 2, 1, 1),
 	SOC_SINGLE("Dither 16-Bit Data Switch", CS4271_ADCCTL, 5, 1, 0),
 	SOC_DOUBLE("High Pass Filter Switch", CS4271_ADCCTL, 1, 0, 1, 1),
-	SOC_DOUBLE_R("Master Playback Switch", CS4271_VOLA, CS4271_VOLB,
-		7, 1, 1),
+	SOC_DOUBLE_EXT("Master Playback Switch", SND_SOC_NOPM, 0, 1, 1, 0,
+		cs4271_playback_switch_get, cs4271_playback_switch_put),
 };
 
 static const struct snd_soc_dai_ops cs4271_dai_ops = {
@@ -559,6 +604,8 @@
 	int ret;
 	bool amutec_eq_bmutec;
 
+	mutex_init(&cs4271->mute_lock);
+
 	amutec_eq_bmutec = of_property_read_bool(component->dev->of_node,
 						 "cirrus,amuteb-eq-bmutec") ||
 			  of_property_read_bool(component->dev->of_node,
