set(CMAKE_SYSTEM_NAME Linux)
set(tools "$ENV{HOME}/.local/share/multiroom-linux")
if(MULTIROOM_TARGET STREQUAL "armv7")
    # Raspberry Pi 2 and newer on a 32-bit OS: Cortex-A7 or later, all with NEON.
    set(CMAKE_SYSTEM_PROCESSOR arm)
    set(prefix "${tools}/x-tools/armv6-rpi-linux-gnueabihf/bin/armv6-rpi-linux-gnueabihf-")
    set(CMAKE_C_COMPILER "${prefix}gcc")
    set(CMAKE_CXX_COMPILER "${prefix}g++")
    execute_process(COMMAND "${CMAKE_C_COMPILER}" -print-sysroot
        OUTPUT_VARIABLE CMAKE_SYSROOT OUTPUT_STRIP_TRAILING_WHITESPACE
        COMMAND_ERROR_IS_FATAL ANY)
    set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
    set(cpu_flags "-march=armv7-a -mtune=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=hard -D_FILE_OFFSET_BITS=64")
    set(CMAKE_EXE_LINKER_FLAGS_INIT "-static-libstdc++ -static-libgcc")
    set(CMAKE_CXX_STANDARD_LIBRARIES_INIT "-latomic")
elseif(MULTIROOM_TARGET MATCHES "^armv[89]$")
    set(CMAKE_SYSTEM_PROCESSOR aarch64)
    set(prefix "${tools}/x-tools/aarch64-rpi3-linux-gnu/bin/aarch64-rpi3-linux-gnu-")
    set(CMAKE_C_COMPILER "${prefix}gcc")
    set(CMAKE_CXX_COMPILER "${prefix}g++")
    execute_process(COMMAND "${CMAKE_C_COMPILER}" -print-sysroot
        OUTPUT_VARIABLE CMAKE_SYSROOT OUTPUT_STRIP_TRAILING_WHITESPACE
        COMMAND_ERROR_IS_FATAL ANY)
    set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
    if(MULTIROOM_TARGET STREQUAL "armv9")
        set(cpu_flags "-march=armv9-a -mtune=generic")
    else()
        set(cpu_flags "-march=armv8-a -mtune=generic")
    endif()
    set(CMAKE_EXE_LINKER_FLAGS_INIT "-static-libstdc++ -static-libgcc")
    set(CMAKE_CXX_STANDARD_LIBRARIES_INIT "-latomic")
else()
    message(FATAL_ERROR "Unknown ServerCore MULTIROOM_TARGET: ${MULTIROOM_TARGET}")
endif()
set(CMAKE_C_FLAGS_INIT "${cpu_flags}")
set(CMAKE_CXX_FLAGS_INIT "${cpu_flags}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES MULTIROOM_TARGET)
