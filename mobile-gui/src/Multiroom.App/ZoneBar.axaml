<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:Multiroom.App" x:Class="Multiroom.App.ZoneBar" x:DataType="vm:ShellViewModel" ClipToBounds="False">
 <Border x:Name="ZoneCard" Background="#252A2C" CornerRadius="0" Margin="0" Padding="0">
  <Grid RowDefinitions="Auto,Auto">
  <!-- Reserves the track's 3 px; the slider overlays it so the dot is drawn over the artwork. -->
  <Border x:Name="SeekTrackSpace" Height="3" IsVisible="{Binding !IsNowPlaying}" />
  <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
   <Button x:Name="NowPlayingZoneSelector" Grid.ColumnSpan="2" IsVisible="{Binding IsNowPlaying}" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="12,8" MinHeight="64" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" AutomationProperties.Name="{Binding Playback.ZonePosition}" ToolTip.Tip="Swipe left or right to change zone">
    <Button.KeyBindings>
     <KeyBinding Gesture="Left" Command="{Binding Playback.ChangeZoneCommand}" CommandParameter="previous" />
     <KeyBinding Gesture="Right" Command="{Binding Playback.ChangeZoneCommand}" CommandParameter="next" />
    </Button.KeyBindings>
    <StackPanel Spacing="10">
     <TextBlock x:Name="NowPlayingZoneName" Text="{Binding Playback.ZoneName}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
     <ItemsControl x:Name="NowPlayingZoneDots" ItemsSource="{Binding Playback.ZoneIndicators}" HorizontalAlignment="Center" AutomationProperties.Name="{Binding Playback.ZonePosition}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
       <DataTemplate x:DataType="x:Boolean">
        <Ellipse Width="6" Height="6" Classes.selected="{Binding}">
         <Ellipse.Styles>
          <Style Selector="Ellipse"><Setter Property="Fill" Value="#50575A" /></Style>
          <Style Selector="Ellipse.selected"><Setter Property="Fill" Value="#C7CCCE" /></Style>
         </Ellipse.Styles>
        </Ellipse>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </Button>
   <Button x:Name="ArtworkButton" IsVisible="{Binding !IsNowPlaying}" Command="{Binding NavigateCommand}" CommandParameter="Now Playing" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0" Margin="0" VerticalAlignment="Stretch" AutomationProperties.Name="Open now playing" ToolTip.Tip="Open now playing">
    <vm:ArtworkView x:Name="ZoneArtwork" Reference="{Binding Playback.CurrentArtwork}" Cache="{Binding Playback.Artwork}" Width="100" Height="100" CornerRadius="0" />
   </Button>
   <Grid x:Name="InfoGrid" Grid.Column="1" RowDefinitions="*,Auto" IsVisible="{Binding !IsNowPlaying}">
    <Grid x:Name="MediaGrid" Margin="12,0,16,0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
      <Button x:Name="MediaButton" IsVisible="{Binding !IsNowPlaying}" Command="{Binding NavigateCommand}" CommandParameter="Now Playing" Background="Transparent" CornerRadius="0" Padding="0" Margin="0,0,10,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.Name="Open now playing">
       <Button.KeyBindings>
        <KeyBinding Gesture="Left" Command="{Binding Playback.ChangeZoneCommand}" CommandParameter="previous" />
        <KeyBinding Gesture="Right" Command="{Binding Playback.ChangeZoneCommand}" CommandParameter="next" />
       </Button.KeyBindings>
       <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock x:Name="MediaTitle" Text="{Binding Playback.Title}" FontSize="18" FontWeight="Bold" TextAlignment="Left" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="MediaSubtitle" Text="{Binding Playback.Subtitle}" Foreground="#A0A8AB" FontSize="12" TextAlignment="Left" TextTrimming="CharacterEllipsis" />
       </StackPanel>
      </Button>
      <Button x:Name="PlayPauseButton" Grid.Column="1" IsVisible="{Binding !IsNowPlaying}" Command="{Binding Playback.PlayPauseCommand}" Background="Transparent" BorderBrush="#CBEC97" BorderThickness="1.5" CornerRadius="20" Padding="0" Width="40" Height="40" MinHeight="40" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding Playback.PlayPauseLabel}" ToolTip.Tip="{Binding Playback.PlayPauseLabel}">
       <Grid Width="24" Height="24">
        <Path Data="M 6,3 L 21,12 L 6,21 Z" Fill="#CBEC97" IsVisible="{Binding !Playback.IsPlaying}" />
        <Path Data="M 5,3 L 10,3 L 10,21 L 5,21 Z M 14,3 L 19,3 L 19,21 L 14,21 Z" Fill="#CBEC97" IsVisible="{Binding Playback.IsPlaying}" />
       </Grid>
      </Button>
      <Arc Classes="busy" Grid.Column="1" Width="40" Height="40" IsVisible="{Binding Playback.PlayPauseCommand.IsRunning}" />
    </Grid>
    <!-- Zone strip: zone name and volume share one darker row beneath the media. -->
    <Border x:Name="ZoneStrip" Grid.Row="1" Background="#000000">
     <Grid ColumnDefinitions="*,Auto" Margin="12,0,20,0">
      <Button x:Name="ZoneButton" Command="{Binding NavigateCommand}" CommandParameter="Now Playing" Background="Transparent" CornerRadius="0" Padding="0" Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding Playback.ZonePosition}" ToolTip.Tip="Swipe left or right to change zone">
       <Button.KeyBindings>
        <KeyBinding Gesture="Left" Command="{Binding Playback.ChangeZoneCommand}" CommandParameter="previous" />
        <KeyBinding Gesture="Right" Command="{Binding Playback.ChangeZoneCommand}" CommandParameter="next" />
       </Button.KeyBindings>
       <StackPanel Orientation="Horizontal" Spacing="6">
        <Path x:Name="ZoneIcon" Data="M 2,11 L 12,2 L 22,11 M 5,9 L 5,22 L 19,22 L 19,9 M 10,22 L 10,15 L 14,15 L 14,22" Stroke="#B5BEC0" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
        <TextBlock x:Name="ZoneName" Text="{Binding Playback.ZoneName}" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
       </StackPanel>
      </Button>
      <Button x:Name="VolumeButton" Grid.Column="1" IsVisible="{Binding !IsNowPlaying}" Command="{Binding OpenVolumeCommand}" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0" Width="32" Height="32" MinHeight="32" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.Name="Zone volume" ToolTip.Tip="Zone volume">
       <Path x:Name="VolumeIcon" Data="M 1.5,7.5 L 5,7.5 L 9,3 L 9,17 L 5,12.5 L 1.5,12.5 Z M 12,6.5 Q 16,10 12,13.5 M 15,3 Q 22,10 15,17" Stroke="#A0A8AB" StrokeThickness="1.5" StrokeLineCap="Round" Width="20" Height="20" />
      </Button>
     </Grid>
    </Border>
   </Grid>
  </Grid>
  <!-- While dragging, the position and track length float above the bar's ends. -->
  <Grid x:Name="ScrubBubbles" Grid.RowSpan="2" ColumnDefinitions="Auto,*,Auto" Margin="8,-38,8,0" VerticalAlignment="Top" IsHitTestVisible="False">
   <Grid.IsVisible>
    <MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="!IsNowPlaying" /><Binding Path="Playback.IsScrubbing" /></MultiBinding>
   </Grid.IsVisible>
   <Grid.Styles>
    <Style Selector="Border"><Setter Property="Background" Value="#252A2C" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Height" Value="24" /><Setter Property="Padding" Value="10,0" /></Style>
    <Style Selector="TextBlock"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
   </Grid.Styles>
   <Border><TextBlock x:Name="ScrubPosition" Text="{Binding Playback.PositionText}" /></Border>
   <Border Grid.Column="2"><TextBlock x:Name="ScrubLength" Text="{Binding Playback.LengthText}" /></Border>
  </Grid>
  <Slider x:Name="ZonePositionSlider" Grid.RowSpan="2" IsVisible="{Binding !IsNowPlaying}" Height="10" Margin="0,-4,0,0" VerticalAlignment="Top" Minimum="0" Maximum="{Binding Playback.ProgressMaximum}"
   Value="{Binding Playback.ProgressSeconds, Mode=TwoWay}" IsEnabled="{Binding Playback.CanScrub}"
   AutomationProperties.Name="Track position">
   <Slider.Resources>
    <GridLength x:Key="SliderPreContentMargin">0</GridLength>
    <GridLength x:Key="SliderPostContentMargin">0</GridLength>
    <x:Double x:Key="SliderHorizontalHeight">10</x:Double>
    <x:Double x:Key="SliderHorizontalThumbWidth">10</x:Double>
    <x:Double x:Key="SliderHorizontalThumbHeight">10</x:Double>
    <x:Double x:Key="SliderTrackThemeHeight">3</x:Double>
   </Slider.Resources>
  </Slider>
  </Grid>
 </Border>
</UserControl>
