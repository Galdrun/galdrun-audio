<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:Multiroom.App" x:Class="Multiroom.App.QueueView" x:DataType="vm:PlaybackViewModel">
 <UserControl.Styles>
  <Style Selector="Button.rowdelete"><Setter Property="IsVisible" Value="False" /></Style>
  <Style Selector="vm|QueueRowView.revealed Button.rowdelete"><Setter Property="IsVisible" Value="True" /></Style>
  <Style Selector="Grid.rowcontent">
   <Setter Property="Transitions"><Transitions><ThicknessTransition Property="Margin" Duration="0:0:0.18" /></Transitions></Setter>
  </Style>
  <Style Selector="vm|QueueRowView.revealed Grid.rowcontent"><Setter Property="Margin" Value="52,0,0,0" /></Style>
  <!-- The playing row is lit, not the selected one: a tap plays a row at once. -->
  <Style Selector="vm|QueueRowView"><Setter Property="MinHeight" Value="64" /><Setter Property="Margin" Value="0,1" /></Style>
  <Style Selector="Border.queuerow"><Setter Property="Padding" Value="4,6" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="vm|QueueRowView:pointerover Border.queuerow"><Setter Property="Background" Value="#1B2123" /></Style>
  <Style Selector="vm|QueueRowView.selected Border.queuerow"><Setter Property="Background" Value="#252D30" /></Style>
  <Style Selector="Border.queuerow.current"><Setter Property="Background" Value="#1F2A26" /></Style>
  <Style Selector="Border.current TextBlock.rowtitle"><Setter Property="Foreground" Value="#CBEC97" /></Style>
  <!-- The playing row's bars: 14 high and scaled from their bottom by the compositor (QueueRowView). -->
  <Style Selector="StackPanel.bars Rectangle">
   <Setter Property="Width" Value="2.5" /><Setter Property="Height" Value="14" /><Setter Property="Fill" Value="#CBEC97" />
   <Setter Property="RadiusX" Value="1" /><Setter Property="RadiusY" Value="1" /><Setter Property="VerticalAlignment" Value="Bottom" />
  </Style>
  <!-- As the web interface's queue: while a row is dragged it follows the finger, faded, and the rows it
       passes slide aside to show where it lands. -->
  <Style Selector="vm|QueueRowView.dragging"><Setter Property="Opacity" Value="0.45" /><Setter Property="ZIndex" Value="1" /></Style>
  <Style Selector="vm|RecyclingRowPanel.reordering > vm|QueueRowView:not(.dragging)">
   <Setter Property="Transitions"><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" /></Transitions></Setter>
  </Style>
 </UserControl.Styles>
 <!-- As the web interface's queue: a count above rows with their number (bars while playing), artwork, two lines
      and length; the playing row is lit. A tap plays a row, its grip moves it, a swipe right shows its delete. -->
 <Grid RowDefinitions="Auto,*">
  <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0,0,10" IsVisible="{Binding !IsEmpty}">
   <Path Data="M 4,7 L 20,7 M 4,12 L 20,12 M 4,17 L 14,17" Stroke="#9BA6A3" StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
   <TextBlock x:Name="QueueCount" Text="{Binding QueueCount}" Classes="muted" FontSize="13" VerticalAlignment="Center" />
  </StackPanel>
  <!-- Rows of one height, made once and given item after item while scrolling (RecyclingRowPanel). -->
  <ScrollViewer Grid.Row="1" x:Name="QueueScroll" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Queue">
   <vm:RecyclingRowPanel x:Name="QueueList" ItemsSource="{Binding Items}" />
  </ScrollViewer>
  <TextBlock Grid.Row="1" Text="Your queue is empty. Choose music from a source." IsVisible="{Binding IsEmpty}" Classes="muted" TextWrapping="Wrap" Margin="8" />
 </Grid>
</UserControl>
