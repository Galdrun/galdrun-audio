<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:Multiroom.App" x:Class="Multiroom.App.HomeView" x:DataType="vm:ShellViewModel">
 <UserControl.Resources>
  <!-- A cover: tap plays it now, the context menu queues it. -->
  <DataTemplate x:Key="Cover" x:DataType="vm:HomeItem">
   <Button Tag="{Binding}" Click="PlayItem" Width="120" Padding="0" Background="Transparent"
    HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Title}"
    ToolTip.Tip="{Binding Reason, TargetNullValue='Play now'}">
    <Button.ContextMenu><ContextMenu>
     <MenuItem Header="Add to queue" Tag="{Binding}" Click="QueueItem" />
    </ContextMenu></Button.ContextMenu>
    <StackPanel Spacing="7">
     <Grid Width="120" Height="120">
      <vm:ArtworkView Reference="{Binding Artwork}" Width="120" Height="120"
       Cache="{Binding $parent[vm:HomeView].((vm:ShellViewModel)DataContext).Browser.Artwork}" />
      <Border Background="#D9101315" CornerRadius="18" Width="36" Height="36" Margin="8"
       HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
       <Path Data="M 0,0 L 0,14 L 11,7 Z" Fill="#EEF1ED" Width="11" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
     </Grid>
     <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
     <TextBlock Text="{Binding Subtitle}" Classes="muted" TextTrimming="CharacterEllipsis" FontSize="12" />
    </StackPanel>
   </Button>
  </DataTemplate>
 </UserControl.Resources>
 <Grid>
  <ScrollViewer x:Name="HomeScroll" IsVisible="{Binding !Home.IsShelfOpen}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
   <StackPanel Spacing="16" Margin="0,0,0,16">
    <TextBlock Text="Loading…" IsVisible="{Binding Home.IsLoading}" Classes="muted" />
    <TextBlock Text="{Binding Home.Notice}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding Home.Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <ItemsControl x:Name="Shelves" ItemsSource="{Binding Home.Shelves}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="16" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:HomeShelf">
      <StackPanel Spacing="6">
       <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
         <Path Data="{Binding Icon}" Stroke="#CBEC97" StrokeThickness="1.8" StrokeJoin="Round" StrokeLineCap="Round" Stretch="Uniform" Width="20" Height="20" VerticalAlignment="Center" />
         <TextBlock Text="{Binding Title}" Classes="section" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="1" Content="See all" IsVisible="{Binding !IsEmpty}" CommandParameter="{Binding}"
         Command="{Binding $parent[vm:HomeView].((vm:ShellViewModel)DataContext).Home.SeeAllCommand}"
         Background="Transparent" AutomationProperties.Name="{Binding Title, StringFormat='See all {0}'}" />
       </Grid>
       <Border IsVisible="{Binding IsEmpty}" Classes="panel">
        <TextBlock Text="{Binding Empty}" Classes="muted" TextWrapping="Wrap" />
       </Border>
       <ListBox ItemsSource="{Binding Items}" ItemTemplate="{StaticResource Cover}" Background="Transparent"
        IsVisible="{Binding !IsEmpty}" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
        AutomationProperties.Name="{Binding Title}">
        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.Styles><Style Selector="ListBoxItem">
         <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,14,0" />
         <Setter Property="Focusable" Value="False" /><Setter Property="VerticalContentAlignment" Value="Top" />
        </Style></ListBox.Styles>
       </ListBox>
      </StackPanel>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
  </ScrollViewer>
  <!-- "See all": a fixed header (the shelf's icon and title, back on the right) over every cover of the shelf. -->
  <Grid x:Name="ShelfPage" IsVisible="{Binding Home.IsShelfOpen}" RowDefinitions="Auto,Auto,*">
   <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
    <Path Data="{Binding Home.OpenShelf.Icon, FallbackValue={x:Null}}" Stroke="#CBEC97" StrokeThickness="1.8" StrokeJoin="Round" StrokeLineCap="Round" Stretch="Uniform" Width="20" Height="20" VerticalAlignment="Center" />
    <TextBlock Grid.Column="1" Text="{Binding Home.OpenShelf.Title, FallbackValue=''}" Classes="section" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
    <Button x:Name="ShelfBack" Grid.Column="2" Content="Back" Command="{Binding Home.CloseShelfCommand}" Background="Transparent"
     VerticalAlignment="Center" AutomationProperties.Name="Back to home" />
   </Grid>
   <Border x:Name="ShelfDivider" Grid.Row="1" Height="1" Background="#2E3638" Margin="0,0,0,14" />
   <ScrollViewer x:Name="ShelfGrid" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
    <!-- As many columns of covers as fit; each cover is scaled up to fill its column, so no space is left on the right. -->
    <ItemsControl x:Name="ShelfItems" ItemsSource="{Binding Home.OpenShelf.All, FallbackValue={x:Null}}" Margin="0,0,-14,16" VerticalAlignment="Top">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding $parent[vm:HomeView].GridColumns}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:HomeItem">
      <Viewbox Stretch="Uniform" Margin="0,0,14,18" VerticalAlignment="Top">
       <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Cover}" />
      </Viewbox>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </ScrollViewer>
  </Grid>
 </Grid>
</UserControl>
