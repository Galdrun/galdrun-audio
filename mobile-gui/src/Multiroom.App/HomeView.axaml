<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:Multiroom.App" x:Class="Multiroom.App.HomeView" x:DataType="vm:ShellViewModel">
 <UserControl.Resources>
  <!-- A cover: tap opens an album, artist or book in Browse and a track or station's sheet;
   a long press or right-click opens the sheet for every cover. -->
  <DataTemplate x:Key="Cover" x:DataType="vm:HomeItem">
   <Button Classes="cover" Tag="{Binding}" Click="OpenItem" ContextRequested="RequestActions" Width="120" Padding="0" Background="Transparent"
    HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Title}" ToolTip.Tip="{Binding Reason}">
    <StackPanel Spacing="7">
     <Grid Width="120" Height="120">
      <vm:ArtworkView Reference="{Binding Artwork}" Width="120" Height="120"
       Cache="{Binding $parent[vm:HomeView].((vm:ShellViewModel)DataContext).Browser.Artwork}" />
      <!-- What it is, its title and subtitle over the artwork's bottom, on a shade that keeps them readable. -->
      <Border VerticalAlignment="Bottom" CornerRadius="0,0,8,8" Padding="8,26,8,7" IsHitTestVisible="False">
       <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
         <GradientStop Offset="0" Color="#00101315" /><GradientStop Offset="0.45" Color="#C0101315" /><GradientStop Offset="1" Color="#F0101315" />
        </LinearGradientBrush>
       </Border.Background>
       <StackPanel Spacing="1">
        <Border Classes="kind" IsVisible="{Binding Kind, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
         <TextBlock Text="{Binding Kind}" />
        </Border>
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Subtitle}" Classes="muted" TextTrimming="CharacterEllipsis" FontSize="11" />
       </StackPanel>
      </Border>
     </Grid>
    </StackPanel>
   </Button>
  </DataTemplate>
 </UserControl.Resources>
 <UserControl.Styles>
  <!-- What the cover is (Track, Radio, Album, Artist, Book), above its title: a tab from the artwork's
   left edge, its text where the title starts (the shade's padding). -->
  <Style Selector="Border.kind">
   <Setter Property="Background" Value="#40CBEC97" /><Setter Property="CornerRadius" Value="0,4,4,0" /><Setter Property="Padding" Value="8,2,6,2" />
   <Setter Property="Margin" Value="-8,0,0,3" /><Setter Property="HorizontalAlignment" Value="Left" />
   <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="Path.refresh">
   <Setter Property="RenderTransform"><Template><RotateTransform /></Template></Setter>
   <Setter Property="vm:VisibilityWatch.TrackShown" Value="True" />
  </Style>
  <!-- Turns about the arrows' circle (12,12 of its 24 box), so the icon stays put while it spins. -->
  <Style Selector="Button#RefreshProposals:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button#RefreshProposals:pressed /template/ ContentPresenter#PART_ContentPresenter, Button#RefreshProposals:disabled /template/ ContentPresenter#PART_ContentPresenter">
   <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
  <Style Selector="Button#RefreshProposals:pressed"><Setter Property="RenderTransform" Value="{x:Null}" /></Style>
  <!-- Dimmed when no AI can propose; not while it runs (the button is disabled then too). -->
  <Style Selector="Button#RefreshProposals:disabled Grid.icon:not(.running)"><Setter Property="Opacity" Value="0.4" /></Style>
  <!-- Turns only while shown (VisibilityWatch), as Arc.busy. -->
  <Style Selector="Path.refresh.running.shown">
   <Style.Animations>
    <Animation Duration="0:0:1" IterationCount="INFINITE">
     <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
     <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
    </Animation>
   </Style.Animations>
  </Style>
  <Style Selector="Border.kind TextBlock">
   <Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#CBEC97" />
  </Style>
 </UserControl.Styles>
 <Grid>
  <ScrollViewer x:Name="HomeScroll" IsVisible="{Binding !Home.IsShelfOpen}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
   <StackPanel Spacing="16" Margin="0,0,0,16">
    <ItemsControl x:Name="Shelves" ItemsSource="{Binding Home.Shelves}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="16" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:HomeShelf">
      <StackPanel Spacing="6">
       <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
         <Path Data="{Binding Icon}" Stroke="#CBEC97" StrokeThickness="1.8" StrokeJoin="Round" StrokeLineCap="Round" Width="24" Height="24" VerticalAlignment="Center" />
         <TextBlock Text="{Binding Title}" Classes="section" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="1" Content="See all" IsVisible="{Binding !IsEmpty}" Tag="{Binding}" Click="SeeAll"
         Background="Transparent" AutomationProperties.Name="{Binding Title, StringFormat='See all {0}'}" />
       </Grid>
       <Border IsVisible="{Binding IsEmpty}" Classes="panel">
        <TextBlock Text="{Binding Empty}" Classes="muted" TextWrapping="Wrap" />
       </Border>
       <ListBox ItemsSource="{Binding Items}" ItemTemplate="{StaticResource Cover}" Background="Transparent"
        IsVisible="{Binding !IsEmpty}" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
        AutomationProperties.Name="{Binding Title}">
        <!-- Not virtualized: a shelf holds at most HomeShelf.Size covers, and recycling them while scrolling
             reloaded their artwork, which made the scroll and its glide stutter. -->
        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.Styles><Style Selector="ListBoxItem">
         <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,14,0" />
         <Setter Property="Focusable" Value="False" /><Setter Property="VerticalContentAlignment" Value="Top" />
        </Style></ListBox.Styles>
       </ListBox>
      </StackPanel>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
  </ScrollViewer>
  <!-- "See all": a fixed header (the shelf's icon and title) over every cover of the shelf; the system back closes it. -->
  <Grid x:Name="ShelfPage" IsVisible="{Binding Home.IsShelfOpen}" RowDefinitions="Auto,Auto,Auto,*">
   <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
    <Path Data="{Binding Home.OpenShelf.Icon, FallbackValue={x:Null}}" Stroke="#CBEC97" StrokeThickness="1.8" StrokeJoin="Round" StrokeLineCap="Round" Width="24" Height="24" VerticalAlignment="Center" />
    <TextBlock Grid.Column="1" Text="{Binding Home.OpenShelf.Title, FallbackValue=''}" Classes="section" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
    <!-- For you asks the AI for new proposals; the arrows turn while it chooses. -->
    <Button x:Name="RefreshProposals" Grid.Column="2" IsVisible="{Binding Home.IsForYouOpen}" Command="{Binding Home.RefreshProposalsCommand}"
     Background="Transparent" BorderThickness="0" Padding="0" Width="40" Height="40" Margin="0,-8,0,-8"
     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
     AutomationProperties.Name="Ask for new proposals" ToolTip.Tip="Ask the AI for new proposals">
     <!-- The AI's sparkle (as For you's own icon) inside a renewing arrow; only the arrow turns. -->
     <Grid Classes="icon" Classes.running="{Binding Home.IsProposing}" Width="26" Height="26">
      <Path x:Name="RefreshProposalsIcon" Classes="refresh" Classes.running="{Binding Home.IsProposing}"
       Data="M 23.5,13 A 10.5,10.5 0 1 1 20.42,5.58 M 21,1.5 L 21,6.5 L 16,6.5" Stroke="#CBEC97" StrokeThickness="1.8" StrokeJoin="Round" StrokeLineCap="Round" Width="26" Height="26" />
      <Path Data="M 13,7 Q 13.6,12.4 19,13 Q 13.6,13.6 13,19 Q 12.4,13.6 7,13 Q 12.4,12.4 13,7 Z" Fill="#CBEC97" Width="26" Height="26" />
     </Grid>
    </Button>
   </Grid>
   <Border x:Name="ShelfDivider" Grid.Row="1" Height="1" Background="#2E3638" Margin="0,0,0,14" />
   <!-- For you's kinds (All, Tracks, Albums, Artists, Books), as the server GUI's: one full-width row of flat,
        equal tabs divided by vertical lines; the picked one has its own background. -->
   <Border Grid.Row="2" IsVisible="{Binding Home.OpenShelf.HasTabs, FallbackValue=False}" Background="#1B2123" Margin="0,-6,0,14">
    <ItemsControl x:Name="ShelfTabs" ItemsSource="{Binding Home.OpenShelf.Tabs, FallbackValue={x:Null}}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.Styles>
      <Style Selector="Button.tab"><Setter Property="Background" Value="Transparent" /><Setter Property="CornerRadius" Value="0" />
       <Setter Property="Padding" Value="4,0" /><Setter Property="MinHeight" Value="44" /><Setter Property="HorizontalAlignment" Value="Stretch" />
       <Setter Property="HorizontalContentAlignment" Value="Center" />
       <Setter Property="BorderThickness" Value="1,0,0,0" /><Setter Property="BorderBrush" Value="#3A4446" /></Style>
      <Style Selector="ContentPresenter:nth-child(1) > Button.tab"><Setter Property="BorderThickness" Value="0" /></Style>
      <Style Selector="Button.tab.selected"><Setter Property="Background" Value="#2C372F" /></Style>
      <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.tab:pressed /template/ ContentPresenter#PART_ContentPresenter">
       <Setter Property="Background" Value="{Binding $parent[Button].Background}" /><Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" /></Style>
      <Style Selector="Button.tab:pressed"><Setter Property="RenderTransform" Value="{x:Null}" /></Style>
      <Style Selector="Button.tab TextBlock"><Setter Property="Foreground" Value="#9BA6A3" /></Style>
      <Style Selector="Button.tab.selected TextBlock"><Setter Property="Foreground" Value="#CBEC97" /></Style>
     </ItemsControl.Styles>
     <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ShelfTab">
      <Button Classes="tab" Classes.selected="{Binding IsSelected}" ContextRequested="RequestTabActions" Command="{Binding $parent[vm:HomeView].((vm:ShellViewModel)DataContext).Home.OpenShelf.ShowKindCommand}"
       CommandParameter="{Binding Kind}" AutomationProperties.Name="{Binding Label}">
       <StackPanel Orientation="Horizontal" Spacing="5">
        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Count}" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding Count, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
       </StackPanel>
      </Button>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </Border>
   <ScrollViewer x:Name="ShelfGrid" Grid.Row="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
    <!-- As many columns of covers as fit; each cover is scaled up to fill its column, so no space is left on the right.
         Rows of covers (HomeView.Rows) in a RecyclingRowPanel: only the rows on screen are built and load their
         artwork, so a long shelf or a tab switch does not lay out and decode every cover at once. -->
    <vm:RecyclingRowPanel x:Name="ShelfItems" Margin="0,0,-14,16" VerticalAlignment="Top">
     <vm:RecyclingRowPanel.ItemsSource>
      <MultiBinding Converter="{x:Static vm:HomeView.Rows}">
       <Binding Path="Home.OpenShelf.Shown" FallbackValue="{x:Null}" />
       <Binding Path="GridColumns" RelativeSource="{RelativeSource AncestorType=vm:HomeView}" />
      </MultiBinding>
     </vm:RecyclingRowPanel.ItemsSource>
    </vm:RecyclingRowPanel>
   </ScrollViewer>
  </Grid>
  <!-- Shown while "See all" lays out its covers, which takes a moment on a phone. -->
  <Border x:Name="ShelfLoading" IsVisible="False" Background="#B0101315" AutomationProperties.Name="Loading">
   <!-- Its own visibility follows the shade's, so it only spins while shown (Arc.busy, App.axaml). -->
   <Arc Classes="busy" Width="48" Height="48" StrokeThickness="4" IsVisible="{Binding #ShelfLoading.IsVisible}" />
  </Border>
 </Grid>
</UserControl>
