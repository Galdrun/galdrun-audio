<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:Multiroom.App" x:Class="Multiroom.App.QueueRowView" x:DataType="vm:QueueRow">
 <!-- One queue row (QueueView): its number (bars while playing), artwork, two lines, length and grip; a swipe right
      shows its delete. Made once and given item after item while scrolling (RecyclingRowPanel). -->
 <Border Classes="queuerow" Classes.current="{Binding IsCurrent, FallbackValue=False}">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
     <Button x:Name="Delete" Classes="rowdelete" CommandParameter="{Binding}" Background="Transparent" CornerRadius="0" Padding="0" Width="44" Height="44" HorizontalAlignment="Left" VerticalAlignment="Center" AutomationProperties.Name="Remove from queue" ToolTip.Tip="Remove from queue">
      <Path Data="M 5,7 L 19,7 M 9,7 L 9,5 L 15,5 L 15,7 M 7,7 L 8,19 L 16,19 L 17,7 M 10,11 L 10,16 M 14,11 L 14,16" Stroke="#F4BA9D" StrokeThickness="1.7" Width="24" Height="24" />
     </Button>
     <Grid Grid.Column="0" Classes="rowcontent" ColumnDefinitions="28,Auto,*">
      <TextBlock Text="{Binding Number}" Classes="muted" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !IsCurrent}" />
      <StackPanel x:Name="Bars" Classes="bars"
       Orientation="Horizontal" Spacing="2" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsCurrent}">
       <Rectangle /><Rectangle /><Rectangle /><Rectangle />
      </StackPanel>
      <vm:ArtworkView x:Name="Picture" Grid.Column="1" Reference="{Binding Artwork}"
       Width="44" Height="44" CornerRadius="6" Margin="6,0,12,0" VerticalAlignment="Center" />
      <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
       <TextBlock Classes="rowtitle" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
       <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="13" TextTrimming="CharacterEllipsis" />
      </StackPanel>
     </Grid>
     <Button Grid.Column="1" IsVisible="{Binding HasFailure}" Background="Transparent" Padding="0" Width="36" Height="36" VerticalAlignment="Center" AutomationProperties.Name="Playback failed, show error" ToolTip.Tip="Playback failed">
      <Path Data="M 12,3 L 22,21 L 2,21 Z M 12,10 L 12,15 M 12,18 L 12,18.01" Stroke="#F4BA9D" StrokeThickness="1.7" Width="24" Height="24" />
      <Button.Flyout><Flyout Placement="Bottom">
       <TextBlock Text="{Binding Item.Failure}" Foreground="#F4BA9D" TextWrapping="Wrap" MaxWidth="320" />
      </Flyout></Button.Flyout>
     </Button>
     <TextBlock Grid.Column="2" Text="{Binding Length}" Classes="muted" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0" />
     <Border Grid.Column="3" Classes="grip" Background="Transparent" Width="52" Height="44" VerticalAlignment="Center" Margin="0,0,10,0">
      <Path Data="M 6,6 L 18,6 M 6,12 L 18,12 M 6,18 L 18,18" Stroke="#9BA6A3" StrokeThickness="1.7" Width="24" Height="24" />
     </Border>
    </Grid>
    </Border>
</UserControl>
