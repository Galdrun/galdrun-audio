<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Multiroom.App"
             x:Class="Multiroom.App.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="Background" Value="#101315" /></Style>
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="#EEF1ED" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#9BA6A3" /></Style>
    <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="32" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.section"><Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Button"><Setter Property="MinHeight" Value="44" /><Setter Property="Padding" Value="16,8" /><Setter Property="CornerRadius" Value="8" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style Selector="Button.accent"><Setter Property="Background" Value="#CBEC97" /><Setter Property="Foreground" Value="#182316" /></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="44" /></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="44" /></Style>
    <!-- The Galdrun button (docs/agents/mobile-gui.md, "Buttons"): flat and square, dark green with the accent text,
         no hover or press change; disabled, the page's dark grey with dim text. -->
    <Style Selector="Button.galdrun">
      <Setter Property="Background" Value="#2C372F" /><Setter Property="Foreground" Value="#CBEC97" />
      <Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="0" />
      <Setter Property="Height" Value="48" /><Setter Property="Padding" Value="20,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.galdrun:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.galdrun:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2C372F" /><Setter Property="Foreground" Value="#CBEC97" />
    </Style>
    <Style Selector="Button.galdrun:pressed"><Setter Property="RenderTransform" Value="{x:Null}" /></Style>
    <Style Selector="Button.galdrun:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1B2123" /><Setter Property="Foreground" Value="#5A6462" />
    </Style>
    <Style Selector="Border.panel"><Setter Property="Background" Value="#1B2123" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="20" /></Style>
    <!-- A spinning ring laid over a round button while its request is pending. -->
    <Style Selector="Arc.busy">
      <Setter Property="StartAngle" Value="0" /><Setter Property="SweepAngle" Value="90" />
      <Setter Property="Stroke" Value="#CBEC97" /><Setter Property="StrokeThickness" Value="3" /><Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="RenderTransform"><Template><RotateTransform /></Template></Setter>
      <Setter Property="local:VisibilityWatch.TrackShown" Value="True" />
    </Style>
    <!-- Spins only while shown, its page included (VisibilityWatch). -->
    <Style Selector="Arc.busy.shown">
      <Style.Animations>
        <Animation Duration="0:0:0.8" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- List rows in the app's colours, not Fluent's blue accent: a dim grey while touched, the dark green of the
         playing queue row while selected. -->
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1B2123" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1F2A26" />
    </Style>
    <Style Selector="ListBoxItem"><Setter Property="MinHeight" Value="64" /><Setter Property="Padding" Value="8" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
  </Application.Styles>
</Application>
