<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:Multiroom.App" xmlns:api="using:Multiroom.App.Api"
 x:Class="Multiroom.App.MainView" x:DataType="vm:ShellViewModel" Background="#101315">
 <UserControl.Styles>
  <!-- No padding around the pages: each keeps 16 px from the window's sides itself, so a page may run edge to edge
       (an album's cover, BrowserView). Pages with no heading above them start 16 px down. -->
  <Style Selector="Grid#Pages > :is(Control)"><Setter Property="Margin" Value="16,0,16,12" /></Style>
  <Style Selector="ListBox#Navigation"><Setter Property="Margin" Value="16,0,4,12" /></Style>
  <Style Selector="Grid#Body.top ListBox#Navigation"><Setter Property="Margin" Value="16,16,4,12" /></Style>
  <Style Selector="Border#SideQueue"><Setter Property="Margin" Value="4,0,16,12" /></Style>
  <Style Selector="Grid#Body.top Border#SideQueue"><Setter Property="Margin" Value="4,16,16,12" /></Style>
 </UserControl.Styles>
 <Grid RowDefinitions="Auto,*,Auto">
   <Border Grid.Row="0" Background="#1B2123">
    <Grid MinHeight="48">
     <Grid ColumnDefinitions="48,*,Auto,1,Auto" IsVisible="{Binding !IsSetup}">
    <Button x:Name="HamburgerButton" Command="{Binding ToggleMenuCommand}" Width="48" Height="48" Background="Transparent" CornerRadius="0" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.Name="Open navigation menu" ToolTip.Tip="Open navigation menu">
     <Path Data="M 4,7 L 20,7 M 4,12 L 20,12 M 4,17 L 20,17" Stroke="#EEF1ED" StrokeThickness="1.7" Width="24" Height="24" />
    </Button>
    <!-- Requests in flight: a dot pulsing after the title, shown only when a request takes a moment. -->
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="6,0,12,0" ClipToBounds="True">
     <TextBlock Text="{Binding Heading}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
     <Ellipse x:Name="BusyDot" Width="8" Height="8" Fill="#CBEC97" VerticalAlignment="Center" IsVisible="{Binding ShowTopProgress}"
      IsHitTestVisible="False" AutomationProperties.Name="Loading">
      <Ellipse.Styles>
       <Style Selector="Ellipse#BusyDot"><Setter Property="Opacity" Value="0" /><Setter Property="vm:VisibilityWatch.TrackShown" Value="True" /></Style>
       <Style Selector="Ellipse#BusyDot.shown">
        <Style.Animations>
         <Animation Duration="0:0:1.1" IterationCount="INFINITE" Easing="SineEaseInOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
         </Animation>
        </Style.Animations>
       </Style>
      </Ellipse.Styles>
     </Ellipse>
    </StackPanel>
    <!-- The queue page's own action, before the divider: the zone's AutoFill on or off (as beside shuffle in the web
         interface), lit while on, dimmed while repeat all or shuffle holds it back. -->
    <Grid Grid.Column="2" IsVisible="{Binding IsQueue}">
     <Button x:Name="AutoFillButton" IsVisible="{Binding Playback.CanAutoFill}" Command="{Binding Playback.ToggleAutoFillCommand}"
      Background="Transparent" CornerRadius="0" Padding="0" Width="48" Height="48"
      AutomationProperties.Name="{Binding Playback.AutoFillLabel}" ToolTip.Tip="{Binding Playback.AutoFillLabel}">
      <Grid Width="24" Height="24">
       <Path Data="M12 3l1.8 4.7 4.7 1.8-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8zM19 15l.8 2.2 2.2.8-2.2.8L19 21l-.8-2.2-2.2-.8 2.2-.8z" Stroke="#EEF1ED" StrokeThickness="1.7" StrokeJoin="Round" Opacity="0.5" IsVisible="{Binding !Playback.IsAutoFillOn}" />
       <Path x:Name="AutoFillOn" Data="M12 3l1.8 4.7 4.7 1.8-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8zM19 15l.8 2.2 2.2.8-2.2.8L19 21l-.8-2.2-2.2-.8 2.2-.8z" Stroke="#CBEC97" Fill="#CBEC97" StrokeThickness="1.7" StrokeJoin="Round" IsVisible="{Binding Playback.IsAutoFillOn}" />
      </Grid>
     </Button>
     <Arc Classes="busy" Width="36" Height="36" IsVisible="{Binding Playback.ToggleAutoFillCommand.IsRunning}" />
    </Grid>
    <Border x:Name="ToolbarDivider" Grid.Column="3" Background="#4A5450" IsHitTestVisible="False" />
    <StackPanel Grid.Column="4" Orientation="Horizontal">
     <Button x:Name="InfoButton" IsVisible="{Binding HasInfo}" Background="Transparent" CornerRadius="0" Padding="0" Width="48" Height="48" AutomationProperties.Name="Information" ToolTip.Tip="Information">
      <Grid Width="24" Height="24">
       <Ellipse Stroke="#CBEC97" StrokeThickness="1.7" Margin="2" />
       <Path Data="M 12,10.5 L 12,17 M 12,7 L 12,7.2" Stroke="#CBEC97" StrokeThickness="2" StrokeLineCap="Round" />
      </Grid>
      <Button.Flyout><Flyout Placement="Bottom">
       <TextBlock x:Name="InfoText" Text="{Binding Info}" TextWrapping="Wrap" MaxWidth="300" />
      </Flyout></Button.Flyout>
     </Button>
     <Button x:Name="SearchButton" Command="{Binding NavigateCommand}" CommandParameter="Search" Background="Transparent" CornerRadius="0" Padding="0" Width="48" Height="48" AutomationProperties.Name="Search" ToolTip.Tip="Search">
      <Path Data="M 10.5,10.5 m -5.5,0 a 5.5,5.5 0 1,0 11,0 a 5.5,5.5 0 1,0 -11,0 M 14.6,14.6 L 20.5,20.5" Stroke="#EEF1ED" StrokeThickness="1.7" Width="24" Height="24" />
     </Button>
     <Button x:Name="QueueButton" Click="QueueTapped" Command="{Binding NavigateCommand}" CommandParameter="Queue" Background="Transparent" CornerRadius="0" Padding="0" Width="48" Height="48" AutomationProperties.Name="Queue" ToolTip.Tip="Queue">
      <Path Data="M 4,7 L 20,7 M 4,12 L 20,12 M 4,17 L 14,17" Stroke="#EEF1ED" StrokeThickness="1.7" Width="24" Height="24" />
     </Button>
    </StackPanel>
    </Grid>
    <TextBlock Text="GALDRUN" IsVisible="{Binding IsSetup}" HorizontalAlignment="Center" VerticalAlignment="Center"
     FontSize="18" FontWeight="Bold" LetterSpacing="5" TextAlignment="Center" />
    </Grid>
   </Border>
   <Grid Grid.Row="1" IsVisible="{Binding !IsSetup}">
  <Grid ColumnDefinitions="190,*,Auto" x:Name="Body" Classes="top">
   <ListBox x:Name="Navigation" ItemsSource="{Binding MenuPages}" SelectedItem="{Binding SelectedPage, Mode=OneWay}" SelectionChanged="PagePicked" Background="Transparent" />
   <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" x:Name="ContentArea">
    <TextBlock Text="{Binding Heading}" Classes="title" Margin="16,16,16,10" IsVisible="{Binding ShowContentHeader}" />
    <Grid Grid.Row="2" x:Name="Pages">
     <Grid IsVisible="{Binding IsHome}" Margin="16,16,16,12"><vm:HomeView /></Grid>
     <Grid IsVisible="{Binding IsCollections}"><vm:CollectionsView DataContext="{Binding Collections}" /></Grid>
     <Grid IsVisible="{Binding IsRooms}"><vm:RoomsView DataContext="{Binding Rooms}" /></Grid>
     <Grid IsVisible="{Binding IsVolume}" Margin="16,16,16,12"><vm:VolumeView DataContext="{Binding Playback}" /></Grid>
     <ScrollViewer IsVisible="{Binding IsDiagnostics}"><TextBlock Text="{Binding Rooms.Diagnostics}" TextWrapping="Wrap" /></ScrollViewer>
     <ScrollViewer IsVisible="{Binding IsAppSettings}">
      <StackPanel Spacing="12" MaxWidth="650" HorizontalAlignment="Stretch">
       <TextBlock Text="Playback" Classes="section" />
       <Border Classes="panel">
        <Grid ColumnDefinitions="*,Auto">
         <StackPanel Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="Play now keeps the queue" FontWeight="SemiBold" />
          <TextBlock Text="Off: Play now and Play in room replace the zone's queue. On: the music goes in after the playing track and starts at once; the rest of the queue stays." Classes="muted" TextWrapping="Wrap" />
         </StackPanel>
         <ToggleSwitch x:Name="PlayNowKeepsQueueSwitch" Grid.Column="1" IsChecked="{Binding PlayNowKeepsQueue}" OnContent="" OffContent=""
          VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Play now keeps the queue" />
        </Grid>
       </Border>
       <TextBlock Text="Developer" Classes="section" Margin="0,12,0,0" />
       <Border Classes="panel">
        <Grid ColumnDefinitions="*,Auto">
         <StackPanel Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="Show performance" FontWeight="SemiBold" />
          <TextBlock Text="The app's CPU use, updated once a second: the whole app in % of all cores, the UI and render threads in % of one core at its current clock. A low clock makes light work look busy." Classes="muted" TextWrapping="Wrap" />
         </StackPanel>
         <ToggleSwitch x:Name="ShowPerformanceSwitch" Grid.Column="1" IsChecked="{Binding ShowPerformance}" OnContent="" OffContent=""
          VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Show performance" />
        </Grid>
       </Border>
      </StackPanel>
     </ScrollViewer>
     <!-- Shown and hidden in MainView.axaml.cs: it slides down from the top when it opens and back up when it
          closes, clipped to the pages so it never passes over the header. -->
     <Grid x:Name="QueueHost" Margin="0" ClipToBounds="True" ZIndex="1">
      <Border x:Name="QueueSheet" Background="#101315" Padding="16,16,0,12"><vm:QueueView x:Name="QueuePage" DataContext="{Binding Playback}" /></Border>
     </Grid>
     <Grid IsVisible="{Binding IsBrowser}" RowDefinitions="Auto,*" Margin="0,0,0,12">
      <Grid IsVisible="{Binding IsSearch}" ColumnDefinitions="*,Auto" Margin="16,0,16,12">
       <TextBox Text="{Binding Browser.Query}" PlaceholderText="Artists, albums, tracks, stations" AutomationProperties.Name="Search all sources">
        <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding Browser.SearchCommand}" /></TextBox.KeyBindings>
       </TextBox>
       <Button Grid.Column="1" Content="Search" Command="{Binding Browser.SearchCommand}" Margin="8,0,0,0" />
      </Grid>
      <vm:BrowserView Grid.Row="1" DataContext="{Binding Browser}" />
     </Grid>
     <ScrollViewer IsVisible="{Binding IsZones}">
      <StackPanel Spacing="12">
       <TextBlock Text="Each zone has its own queue." Classes="muted" />
       <ComboBox ItemsSource="{Binding Playback.ZoneChoices}" DisplayMemberBinding="{Binding Name, x:DataType=vm:ZoneChoice}" SelectedValueBinding="{Binding Zone, x:DataType=vm:ZoneChoice}" SelectedValue="{Binding Playback.SelectedZone}" HorizontalAlignment="Stretch" AutomationProperties.Name="Zone" />
       <TextBox Text="{Binding Playback.NewZone}" PlaceholderText="New zone name" />
       <Button Content="Create / use zone" Command="{Binding Playback.CreateZoneCommand}" />
       <Button Content="Delete selected zone and queue" Command="{Binding Playback.DeleteZoneCommand}" />
       <TextBlock Text="Rooms in this zone" Classes="section" Margin="0,16,0,0" />
       <ItemsControl ItemsSource="{Binding Playback.Membership}">
        <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:RoomChoice"><CheckBox Content="{Binding Name}" IsChecked="{Binding Assigned}" MinHeight="44" /></DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
       <Button Content="Apply full room membership" Command="{Binding Playback.SaveMembershipCommand}" IsEnabled="{Binding Playback.HasZone}" />
      </StackPanel>
     </ScrollViewer>
     <!-- Shown and hidden in MainView.axaml.cs: it slides down over the next page when it closes. -->
     <Grid x:Name="NowPlayingPage" ZIndex="1" Margin="0,16,0,12" Background="Transparent"><vm:NowPlayingView /></Grid>
      <Grid IsVisible="{Binding IsSources}" RowDefinitions="Auto,*,Auto">
      <TextBlock Text="Choose where the music begins." Classes="muted" Margin="0,0,0,20" />
      <ListBox Grid.Row="1" ItemsSource="{Binding Providers}" Background="Transparent" SelectedItem="{Binding SelectedProvider}">
       <ListBox.ItemTemplate><DataTemplate x:DataType="api:ProviderView">
        <Border Classes="panel" HorizontalAlignment="Stretch"><StackPanel Spacing="6">
         <TextBlock Text="{Binding DisplayName}" Classes="section" />
         <TextBlock Text="{Binding Id}" Classes="muted" />
         <TextBlock Text="{Binding State}" Foreground="#CBEC97" />
         <TextBlock Text="{Binding Detail}" Classes="muted" TextWrapping="Wrap" />
         <ItemsControl ItemsSource="{Binding Capabilities}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
         <ItemsControl ItemsSource="{Binding Root}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="api:BrowseNode"><TextBlock Text="{Binding Title}" Classes="muted" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel></Border>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Grid.Row="1" Text="Connect to a server to discover your music sources." IsVisible="{Binding NoSources}" Classes="muted" TextWrapping="Wrap" />
      <Button Grid.Row="2" Content="Browse source" Command="{Binding BrowseProviderCommand}" IsEnabled="{Binding CanBrowseProvider}" Classes="accent" Margin="0,12,0,0" HorizontalAlignment="Left" />
     </Grid>
    </Grid>
   </Grid>
   <Border x:Name="SideQueue" Grid.Column="2" Width="290" IsVisible="{Binding ShowSideQueue}" Background="#151B1D" CornerRadius="12" Padding="12">
    <Grid RowDefinitions="Auto,*"><TextBlock Text="Up next" Classes="section" Margin="8,4,0,16" />
     <vm:QueueView Grid.Row="1" DataContext="{Binding Playback}" /></Grid>
   </Border>
   </Grid>
   </Grid>
    <Grid Grid.Row="1" IsVisible="{Binding IsServers}" RowDefinitions="Auto,Auto,*,Auto" Margin="24,8,24,16" MaxWidth="760" HorizontalAlignment="Stretch">
     <StackPanel Grid.Row="1" Margin="0,0,0,12">
      <TextBlock Text="{Binding Servers.Warning}" Foreground="#F4BA9D" FontWeight="SemiBold" TextWrapping="Wrap"
       IsVisible="{Binding Servers.HasWarning}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="600" Margin="0,0,0,8" />
      <TextBlock Text="{Binding Servers.ScanState}" Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="600" />
     </StackPanel>
     <ListBox x:Name="ServerList" Grid.Row="2" ItemsSource="{Binding Servers.Servers}" Background="Transparent" AutomationProperties.Name="Discovered servers">
      <!-- Rows on the page's own background, touched or not: each is chosen by its Connect button. -->
      <ListBox.Styles>
       <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
       <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" /></Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate><DataTemplate x:DataType="api:DiscoveredServer">
       <Border x:Name="ServerRow" Padding="4,12" HorizontalAlignment="Stretch">
        <Grid ColumnDefinitions="*,Auto">
         <StackPanel Spacing="6">
          <TextBlock Text="{Binding Name}" Classes="section" />
          <TextBlock Text="{Binding Endpoint}" Classes="muted" />
          <TextBlock Text="{Binding Detail}" Classes="muted" TextWrapping="Wrap" />
         </StackPanel>
         <Button Grid.Column="1" Content="Connect" Classes="galdrun" VerticalAlignment="Center" MinWidth="120" Margin="12,0,0,0"
          Command="{Binding $parent[vm:MainView].DataContext.Servers.ConnectServerCommand}" CommandParameter="{Binding}"
          AutomationProperties.Name="Connect server" />
        </Grid>
       </Border>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel Grid.Row="3" Spacing="12" Margin="0,16,0,0">
      <!-- Indeterminate only while scanning: its animation ran even hidden, kept Avalonia's frame timer going and
           cost the UI thread nearly a whole core on a phone (measured). -->
      <ProgressBar IsIndeterminate="{Binding Servers.IsScanning}" IsVisible="{Binding Servers.IsScanning}" Height="3" />
      <Grid ColumnDefinitions="*,12,*">
       <Button x:Name="ScanButton" Classes="galdrun" Content="Scan" HorizontalAlignment="Stretch"
        Command="{Binding Servers.ScanCommand}" AutomationProperties.Name="Scan for servers" />
       <Button x:Name="ServersManualButton" Grid.Column="2" Classes="galdrun" Content="Manual" HorizontalAlignment="Stretch"
        Command="{Binding NavigateCommand}" CommandParameter="Server" AutomationProperties.Name="Enter a server address manually" />
      </Grid>
     </StackPanel>
     </Grid>
     <!-- Manual: on the page's own background. The address may be a plain host or IP (ShellViewModel.ManualAddress). -->
     <Grid Grid.Row="1" IsVisible="{Binding IsSettings}" Margin="24,24,24,16" MaxWidth="650" HorizontalAlignment="Stretch">
      <StackPanel Spacing="12">
       <TextBlock Text="Connect to your music" Classes="section" />
       <TextBlock Text="Galdrun server address" Classes="muted" />
       <TextBox x:Name="ServerAddress" Text="{Binding Address}" PlaceholderText="10.0.0.6" AutomationProperties.Name="Server address" />
       <TextBlock Text="API bearer token (optional, kept for this session only)" Classes="muted" TextWrapping="Wrap" />
       <TextBox Text="{Binding Token}" PasswordChar="●" AutomationProperties.Name="API bearer token" />
       <Grid ColumnDefinitions="*,12,*" Margin="0,12,0,0">
        <Button x:Name="ManualConnectButton" Classes="galdrun" Content="Connect" HorizontalAlignment="Stretch"
         Command="{Binding ConnectCommand}" AutomationProperties.Name="Connect to the entered server" />
        <!-- Back to where Manual was opened: the connecting page (its search goes on) or the server list. -->
        <Button x:Name="ManualBackButton" Grid.Column="2" Classes="galdrun" Content="Back" HorizontalAlignment="Stretch"
         Command="{Binding BackCommand}" AutomationProperties.Name="Back" />
       </Grid>
      </StackPanel>
     </Grid>
    <vm:ZoneBar Grid.Row="2" x:Name="BottomZoneBar" IsVisible="{Binding ShowZoneBar}" />
    <!-- Zone Setup: shown and hidden in MainView.axaml.cs, as Now Playing. It rises over the pages and the zone bar
         together (with the page's background), so nothing beneath it is laid out anew while it moves. -->
    <Grid x:Name="ZoneSetupPage" Grid.Row="1" Grid.RowSpan="2" Background="#101315">
     <vm:ZoneSetupView DataContext="{Binding Playback}" Margin="16,16,16,12" />
    </Grid>
    <!-- The menu: a drawer sliding in from the left over the whole page; the dimmed rest (or back) closes it.
         Closed, it is hidden, not only moved away, so its pages are never seen (or read out) twice. -->
    <Grid x:Name="MenuDrawer" Grid.RowSpan="3" ColumnDefinitions="Auto,*" Classes.open="{Binding IsMenuOpen}">
     <Grid.Styles>
      <Style Selector="Grid#MenuDrawer"><Setter Property="IsHitTestVisible" Value="False" /></Style>
      <Style Selector="Grid#MenuDrawer.open"><Setter Property="IsHitTestVisible" Value="True" /></Style>
      <Style Selector="Border#MenuScrim">
       <Setter Property="Opacity" Value="0" />
       <Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.22" /></Transitions></Setter>
      </Style>
      <Style Selector="Grid#MenuDrawer.open Border#MenuScrim"><Setter Property="Opacity" Value="1" /></Style>
      <Style Selector="Border#MenuPanel">
       <Setter Property="RenderTransform" Value="translateX(-300px)" /><Setter Property="IsEnabled" Value="False" />
       <Setter Property="Transitions"><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" /></Transitions></Setter>
      </Style>
      <Style Selector="Grid#MenuDrawer.open Border#MenuPanel"><Setter Property="RenderTransform" Value="translateX(0px)" /><Setter Property="IsEnabled" Value="True" /></Style>
     </Grid.Styles>
     <Border x:Name="MenuScrim" Grid.ColumnSpan="2" Background="#A6000000" Tapped="MenuScrimTapped" />
     <Border x:Name="MenuPanel" Width="280" Background="#1B2123" IsVisible="{Binding IsMenuOpen}">
      <Grid RowDefinitions="Auto,*">
       <TextBlock Text="GALDRUN" FontSize="18" FontWeight="Bold" LetterSpacing="5" Margin="20,16,20,12" />
       <ListBox x:Name="PagePicker" Grid.Row="1" ItemsSource="{Binding MenuPages}" SelectedItem="{Binding SelectedPage, Mode=OneWay}" SelectionChanged="PagePicked"
        Background="Transparent" Margin="8,0,8,12" AutomationProperties.Name="Choose page" />
      </Grid>
     </Border>
    </Grid>
    <!-- An item's sheet: slides up over the whole page; the dimmed rest closes it. -->
    <Grid x:Name="ItemSheet" Grid.RowSpan="3" RowDefinitions="*,Auto" Classes.open="{Binding Home.IsSheetOpen}">
     <Grid.Styles>
      <Style Selector="Grid#ItemSheet"><Setter Property="IsHitTestVisible" Value="False" /></Style>
      <Style Selector="Grid#ItemSheet.open"><Setter Property="IsHitTestVisible" Value="True" /></Style>
      <Style Selector="Border#SheetScrim">
       <Setter Property="Opacity" Value="0" />
       <Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.22" /></Transitions></Setter>
      </Style>
      <Style Selector="Grid#ItemSheet.open Border#SheetScrim"><Setter Property="Opacity" Value="1" /></Style>
      <Style Selector="Border#SheetPanel">
       <Setter Property="RenderTransform" Value="translateY(900px)" /><Setter Property="IsEnabled" Value="False" />
       <Setter Property="Transitions"><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" /></Transitions></Setter>
      </Style>
      <Style Selector="Grid#ItemSheet.open Border#SheetPanel"><Setter Property="RenderTransform" Value="translateY(0px)" /><Setter Property="IsEnabled" Value="True" /></Style>
      <Style Selector="Border#SheetPanel Button.sheet">
       <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" />
       <Setter Property="MinHeight" Value="50" /><Setter Property="Padding" Value="18,8" /><Setter Property="Background" Value="#252D30" />
       <Setter Property="FontSize" Value="15" />
      </Style>
      <Style Selector="Border#SheetPanel Button.mark">
       <Setter Property="Background" Value="Transparent" /><Setter Property="CornerRadius" Value="24" /><Setter Property="Padding" Value="12" />
       <Setter Property="Width" Value="48" /><Setter Property="Height" Value="48" />
      </Style>
     </Grid.Styles>
     <Border x:Name="SheetScrim" Grid.RowSpan="2" Background="#A6000000" Tapped="SheetScrimTapped" />
     <Border x:Name="SheetPanel" Grid.Row="1" Background="#1B2123" CornerRadius="16,16,0,0" Padding="16,18,16,24" MaxWidth="640">
      <StackPanel Spacing="14">
       <Grid ColumnDefinitions="72,*,Auto">
        <vm:ArtworkView Reference="{Binding Home.SheetItem.Artwork, FallbackValue={x:Null}}" Cache="{Binding Browser.Artwork}" Width="72" Height="72" VerticalAlignment="Top" />
        <StackPanel Grid.Column="1" Margin="14,0,8,0" Spacing="4" VerticalAlignment="Center">
         <Border Background="#101315" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
          IsVisible="{Binding Home.SheetItem.Kind, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}">
          <TextBlock Text="{Binding Home.SheetItem.Kind, FallbackValue=''}" FontSize="10" FontWeight="SemiBold" Foreground="#CBEC97" />
         </Border>
         <TextBlock x:Name="SheetTitle" Text="{Binding Home.SheetItem.Title, FallbackValue=''}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
         <TextBlock Text="{Binding Home.SheetItem.Subtitle, FallbackValue=''}" Classes="muted" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
         <Button x:Name="SheetLike" Classes="mark" IsVisible="{Binding Home.CanLike}" Command="{Binding Home.ToggleLikeCommand}"
          AutomationProperties.Name="I like it" ToolTip.Tip="I like it">
          <Grid Width="22" Height="22">
           <Path Data="M 12,21 L 3,12 C -3,4 7,-1 12,6 C 17,-1 27,4 21,12 Z" Stroke="#EEF1ED" StrokeThickness="1.7" Stretch="Uniform" IsVisible="{Binding !Home.IsLiked}" />
           <Path Data="M 12,21 L 3,12 C -3,4 7,-1 12,6 C 17,-1 27,4 21,12 Z" Fill="#CBEC97" Stretch="Uniform" IsVisible="{Binding Home.IsLiked}" />
          </Grid>
         </Button>
         <Button x:Name="SheetFavorite" Classes="mark" IsVisible="{Binding Home.CanFavorite}" Command="{Binding Home.ToggleFavoriteCommand}"
          AutomationProperties.Name="Favourite" ToolTip.Tip="Favourite">
          <Grid Width="22" Height="22">
           <Path Data="M 12,2 L 15,8.5 L 22,9.5 L 17,14.5 L 18,22 L 12,18.5 L 6,22 L 7,14.5 L 2,9.5 L 9,8.5 Z" Stroke="#EEF1ED" StrokeThickness="1.7" Stretch="Uniform" IsVisible="{Binding !Home.FavoriteSaved}" />
           <Path Data="M 12,2 L 15,8.5 L 22,9.5 L 17,14.5 L 18,22 L 12,18.5 L 6,22 L 7,14.5 L 2,9.5 L 9,8.5 Z" Fill="#CBEC97" Stretch="Uniform" IsVisible="{Binding Home.FavoriteSaved}" />
          </Grid>
         </Button>
        </StackPanel>
       </Grid>
       <Border Height="1" Background="#2E3638" />
       <StackPanel x:Name="SheetActions" Spacing="8" IsVisible="{Binding Home.IsActionsStep}">
        <Button Classes="sheet" Content="Add at end" Command="{Binding Home.QueueCommand}" CommandParameter="{Binding Home.SheetItem}" />
        <Button Classes="sheet" Content="Add as next" Command="{Binding Home.PlayNextCommand}" CommandParameter="{Binding Home.SheetItem}" />
        <Button Classes="sheet" Content="Play now" Command="{Binding Home.PlayNowCommand}" />
        <Button Classes="sheet" Content="Play in room" Command="{Binding Home.ChooseZoneCommand}" />
        <Button Classes="sheet" Content="Add to playlist" Command="{Binding Home.ChoosePlaylistCommand}" IsVisible="{Binding Home.CanAddToPlaylist}" />
       </StackPanel>
       <StackPanel x:Name="SheetZones" Spacing="8" IsVisible="{Binding Home.IsZonesStep}">
        <TextBlock Text="Play in room" Classes="section" FontSize="16" />
        <TextBlock Text="No zones yet. Create one under Zones." Classes="muted" IsVisible="{Binding !Playback.ZoneChoices.Count}" />
        <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Hidden">
         <ItemsControl ItemsSource="{Binding Playback.ZoneChoices}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ZoneChoice">
           <Button Classes="sheet" Content="{Binding Name}" CommandParameter="{Binding Zone}"
            Command="{Binding $parent[vm:MainView].((vm:ShellViewModel)DataContext).Home.PlayInCommand}" />
          </DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
        </ScrollViewer>
       </StackPanel>
       <StackPanel x:Name="SheetPlaylists" Spacing="8" IsVisible="{Binding Home.IsPlaylistsStep}">
        <TextBlock Text="Add to playlist" Classes="section" FontSize="16" />
        <TextBlock Text="No playlists yet. Create one under Playlists." Classes="muted" IsVisible="{Binding !Home.Playlists.Count}" />
        <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Hidden">
         <ItemsControl ItemsSource="{Binding Home.Playlists}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="api:Playlist">
           <Button Classes="sheet" Content="{Binding Name}" CommandParameter="{Binding}"
            Command="{Binding $parent[vm:MainView].((vm:ShellViewModel)DataContext).Home.AddToPlaylistCommand}" />
          </DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
        </ScrollViewer>
       </StackPanel>
      </StackPanel>
     </Border>
    </Grid>
    <!-- Devices waking from deep sleep to play: a pill over the page's bottom (beneath an error's toast) until
         one is back (PlaybackViewModel.WakingText). -->
    <Border x:Name="WakingToast" Grid.Row="1" Classes.shown="{Binding Playback.IsWaking}" IsHitTestVisible="False"
     HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,16" MaxWidth="480"
     Background="#F21B2123" BorderBrush="#3A4A33" BorderThickness="1" CornerRadius="20" Padding="12,8,16,8"
     AutomationProperties.LiveSetting="Polite">
     <Border.Styles>
      <Style Selector="Border#WakingToast"><Setter Property="Opacity" Value="0" /></Style>
      <Style Selector="Border#WakingToast.shown"><Setter Property="Opacity" Value="1" /></Style>
     </Border.Styles>
     <Border.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.3" /></Transitions></Border.Transitions>
     <StackPanel Orientation="Horizontal" Spacing="10">
      <Arc Classes="busy" Width="18" Height="18" StrokeThickness="2.5" IsVisible="{Binding Playback.IsWaking}" />
      <TextBlock x:Name="WakingText" Text="{Binding Playback.WakingText}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
     </StackPanel>
    </Border>
    <!-- Errors: a toast over the page's bottom that fades out by itself, never moving the page. -->
    <Border x:Name="ErrorToast" Grid.Row="1" Classes.shown="{Binding ShowError}" IsHitTestVisible="False"
     HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,16" MaxWidth="480"
     Background="#F21B2123" BorderBrush="#3A2E2A" BorderThickness="1" CornerRadius="10" Padding="14,10">
     <Border.Styles>
      <Style Selector="Border#ErrorToast"><Setter Property="Opacity" Value="0" /></Style>
      <Style Selector="Border#ErrorToast.shown"><Setter Property="Opacity" Value="1" /></Style>
     </Border.Styles>
     <Border.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.3" /></Transitions></Border.Transitions>
     <TextBlock x:Name="ErrorText" Text="{Binding Error}" Foreground="#F4BA9D" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" />
    </Border>
    <!-- Connecting: the logo pulsing over everything while the app searches for its server, at a start and after the
         connection drops (ShellViewModel.SearchAsync). The pulse runs only while it shows (VisibilityWatch). -->
    <Grid x:Name="ConnectingPage" Grid.RowSpan="3" Background="#101315" IsVisible="{Binding IsConnecting}" AutomationProperties.LiveSetting="Polite">
     <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="36" Margin="16,0">
      <Viewbox x:Name="ConnectingLogo" Width="240" Stretch="Uniform" AutomationProperties.Name="Galdrun">
       <Viewbox.Styles>
        <Style Selector="Viewbox#ConnectingLogo"><Setter Property="vm:VisibilityWatch.TrackShown" Value="True" /></Style>
        <Style Selector="Viewbox#ConnectingLogo.shown">
         <Style.Animations>
          <Animation Duration="0:0:1.6" IterationCount="INFINITE" Easing="SineEaseInOut">
           <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
           <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1" /></KeyFrame>
           <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
          </Animation>
         </Style.Animations>
        </Style>
       </Viewbox.Styles>
       <!-- docs/branding/02_pure_wordmark_dark.svg, cropped to the name and its runes. -->
       <Canvas Width="545" Height="186">
        <Canvas.Styles>
         <Style Selector="Path.rune"><Setter Property="Stroke" Value="#8098A5" /><Setter Property="StrokeThickness" Value="3.2" /><Setter Property="StrokeLineCap" Value="Square" /><Setter Property="StrokeJoin" Value="Miter" /></Style>
        </Canvas.Styles>
        <Path Canvas.Left="-323" Canvas.Top="-60" Fill="#EAF2F5" Data="M361.02 129.91Q353.52 129.91 347.19 127.47Q340.85 125.04 336.18 120.57Q331.51 116.1 328.92 110.06Q326.33 104.01 326.33 96.8Q326.33 89.59 328.92 83.54Q331.51 77.5 336.23 73.03Q340.94 68.56 347.29 66.13Q353.64 63.69 361.24 63.69Q369.37 63.69 375.95 66.35Q382.52 69.01 387.08 74.19L379.52 81.54Q375.76 77.72 371.38 75.93Q366.99 74.13 361.79 74.13Q356.68 74.13 352.38 75.8Q348.08 77.46 344.93 80.5Q341.79 83.54 340.08 87.68Q338.38 91.83 338.38 96.8Q338.38 101.67 340.08 105.82Q341.79 109.97 344.93 113.05Q348.08 116.13 352.33 117.8Q356.57 119.47 361.67 119.47Q366.47 119.47 370.93 117.95Q375.39 116.42 379.42 112.83L386.2 121.72Q381.19 125.76 374.53 127.84Q367.87 129.91 361.02 129.91ZM386.2 121.72 374.95 120.16V96.09H386.2ZM402.86 129 431.81 64.6H443.63L472.66 129H460.14L435.27 70.98H440.05L415.17 129ZM416.24 114.09 419.44 104.7H454.19L457.47 114.09ZM490.92 129V64.6H502.86V118.89H536.5V129ZM556.03 129V64.6H584.17Q594.61 64.6 602.52 68.63Q610.43 72.66 614.87 79.88Q619.31 87.09 619.31 96.8Q619.31 106.5 614.87 113.72Q610.43 120.94 602.52 124.97Q594.61 129 584.17 129ZM567.97 118.88H583.57Q590.81 118.88 596.1 116.13Q601.4 113.38 604.33 108.41Q607.26 103.44 607.26 96.8Q607.26 90.07 604.33 85.14Q601.4 80.22 596.1 77.47Q590.81 74.72 583.57 74.72H567.97ZM642.02 129V64.6H668.34Q681.23 64.6 688.56 70.69Q695.89 76.78 695.89 87.53Q695.89 94.58 692.58 99.68Q689.27 104.78 683.14 107.51Q677 110.24 668.46 110.24H648.63L653.96 104.85V129ZM684.1 129 667.79 105.62H680.62L697.03 129ZM653.96 106.12 648.63 100.36H667.96Q675.84 100.36 679.84 96.97Q683.84 93.59 683.84 87.53Q683.84 81.39 679.84 78.04Q675.84 74.7 667.96 74.7H648.63L653.96 68.86ZM746.89 129.91Q733.68 129.91 726.2 122.47Q718.72 115.02 718.72 100.9V64.6H730.66V100.5Q730.66 110.42 734.93 114.94Q739.2 119.47 747 119.47Q754.8 119.47 759.06 114.94Q763.33 110.42 763.33 100.5V64.6H775.06V100.9Q775.06 115.02 767.58 122.47Q760.1 129.91 746.89 129.91ZM801.86 129V64.6H811.7L852.06 114.21H847.15V64.6H859.02V129H849.18L808.82 79.39H813.73V129Z" />
        <Path Classes="rune" Canvas.Left="74" Canvas.Top="142" Data="M 7 6 L 37 38 M 37 6 L 7 38" />
        <Path Classes="rune" Canvas.Left="135" Canvas.Top="142" Data="M 10 38 L 10 6 M 10 10 L 38 24 M 10 22 L 38 36" />
        <Path Classes="rune" Canvas.Left="196" Canvas.Top="142" Data="M 10 6 L 10 38 M 10 6 L 36 20" />
        <Path Classes="rune" Canvas.Left="257" Canvas.Top="142" Data="M 6 6 L 6 38 M 38 6 L 38 38 M 6 6 L 38 38 M 6 38 L 38 6" />
        <Path Classes="rune" Canvas.Left="318" Canvas.Top="142" Data="M 10 38 L 10 6 L 32 6 L 39 15 L 32 24 L 10 24 M 27 24 L 39 38" />
        <Path Classes="rune" Canvas.Left="379" Canvas.Top="142" Data="M 10 6 L 10 38 L 37 38 L 37 6" />
        <Path Classes="rune" Canvas.Left="440" Canvas.Top="142" Data="M 10 38 L 10 6 M 5 29 L 39 15" />
       </Canvas>
      </Viewbox>
      <TextBlock x:Name="ConnectingText" Text="{Binding ConnectingText}" Classes="muted" TextAlignment="Center" TextWrapping="Wrap" FontSize="15" LetterSpacing="1" HorizontalAlignment="Center" />
     </StackPanel>
     <!-- After four seconds without a server: the search goes on, and the address can be entered by hand. -->
     <Button x:Name="ManualButton" Classes="galdrun" Content="Manual" IsVisible="{Binding ShowManual}" Command="{Binding OpenManualCommand}"
      HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40" MinWidth="160"
      AutomationProperties.Name="Enter a server address manually" />
    </Grid>
    <!-- Settings → Show performance: the app's CPU use over every page, top right, never taking a tap. -->
    <vm:PerformanceView x:Name="Performance" Grid.Row="1" IsVisible="{Binding ShowPerformance}"
     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,8,0" Padding="8,3" FontSize="12"
     Foreground="#CBEC97" Background="#E6101315" />
 </Grid>
</UserControl>
