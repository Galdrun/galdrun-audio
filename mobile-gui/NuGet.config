<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Avalonia's nightly builds, for the pinned Avalonia 12.2 nightly (Directory.Build.props). -->
    <add key="avalonia-nightly" value="https://nuget-feed-nightly.avaloniaui.net/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org"><package pattern="*" /><package pattern="Avalonia" /><package pattern="Avalonia.*" /></packageSource>
    <packageSource key="avalonia-nightly"><package pattern="Avalonia" /><package pattern="Avalonia.*" /></packageSource>
  </packageSourceMapping>
</configuration>
